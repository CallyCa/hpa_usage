digraph HPA_v2beta1 {
  rankdir=TB
  graph [fontname="Arial" fontsize=10 pad=0.4 nodesep=0.4 ranksep=0.6 label="HPA Feature Model — autoscaling/v2beta1" labelloc=t labeljust=l fontsize=13]
  node  [fontname="Arial" fontsize=10 shape=box style=filled fillcolor=white]
  edge  [fontname="Arial" fontsize=9]

  // ── Legend ────────────────────────────────────────────────────────────
  subgraph cluster_legend {
    rankdir=TB
    label="Legend" fontsize=9 style=filled fillcolor="#f5f5f5" color="#999999"
    node [shape=plaintext style="" fillcolor="" fontsize=9 margin="0.05,0.02"]
    l1 [label="━━━━━  Mandatory (bold edge)"]
    l2 [label="━━○━━  Optional (circle end)"]
    l3 [label="    △    Alternative group"]
    l4 [label="- - - -   Requires (dashed)"]
    l5 [label="■  White   = since v1"]
    l6 [label="■  Orange  = new in v2beta1"]
    l1 -> l2 -> l3 -> l4 -> l5 -> l6 [style=invis]
  }

  // ── Colors ────────────────────────────────────────────────────────────
  // white  (#ffffff / black border) = v1
  // orange (#FFE0B2 / #E65100)      = new in v2beta1

  // ── Root ──────────────────────────────────────────────────────────────
  HPA [label="HorizontalPodAutoscaler\n(autoscaling/v2beta1)" fillcolor=white]

  // ── Top-level ─────────────────────────────────────────────────────────
  apiVersion [label="apiVersion" fillcolor=white]
  kind_root  [label="kind"       fillcolor=white]
  metadata   [label="metadata"   fillcolor=white]
  spec       [label="spec"       fillcolor=white]
  status     [label="status"     fillcolor=white]

  HPA -> apiVersion [penwidth=2 arrowhead=none]
  HPA -> kind_root  [penwidth=2 arrowhead=none]
  HPA -> metadata   [penwidth=2 arrowhead=none]
  HPA -> spec       [penwidth=2 arrowhead=none]
  HPA -> status     [arrowhead=odot penwidth=1]

  // ── metadata ──────────────────────────────────────────────────────────
  meta_name    [label="name"         fillcolor=white]
  meta_ns      [label="namespace"    fillcolor=white]
  meta_labels  [label="labels"       fillcolor=white]
  meta_ann     [label="annotations"  fillcolor=white]
  meta_genname [label="generateName" fillcolor=white]

  metadata -> meta_name    [penwidth=2 arrowhead=none]
  metadata -> meta_ns      [arrowhead=odot penwidth=1]
  metadata -> meta_labels  [arrowhead=odot penwidth=1]
  metadata -> meta_ann     [arrowhead=odot penwidth=1]
  metadata -> meta_genname [arrowhead=odot penwidth=1]

  // ── spec ──────────────────────────────────────────────────────────────
  scaleTargetRef [label="scaleTargetRef" fillcolor=white]
  replicas_grp   [label="Replicas"       fillcolor=white]
  // NEW in v2beta1: spec.metrics[]
  metrics_grp [label="Metrics\n(spec.metrics[ ])" fillcolor="#FFE0B2" color="#E65100" fontcolor=black]

  spec -> scaleTargetRef [penwidth=2 arrowhead=none]
  spec -> replicas_grp   [penwidth=2 arrowhead=none]
  spec -> metrics_grp    [arrowhead=odot penwidth=1 color="#E65100"]

  // scaleTargetRef
  str_kind [label="kind"       fillcolor=white]
  str_name [label="name"       fillcolor=white]
  str_api  [label="apiVersion" fillcolor=white]
  scaleTargetRef -> str_kind [penwidth=2 arrowhead=none]
  scaleTargetRef -> str_name [penwidth=2 arrowhead=none]
  scaleTargetRef -> str_api  [arrowhead=odot penwidth=1]

  alt_kind [label="△" shape=triangle fillcolor=white width=0.3 height=0.3]
  str_kind -> alt_kind [penwidth=2 arrowhead=none]
  k_deploy [label="Deployment"            fillcolor=white]
  k_rs     [label="ReplicaSet"            fillcolor=white]
  k_ss     [label="StatefulSet"           fillcolor=white]
  k_rc     [label="Replication\nController" fillcolor=white]
  alt_kind -> k_deploy [penwidth=2 arrowhead=none]
  alt_kind -> k_rs     [penwidth=2 arrowhead=none]
  alt_kind -> k_ss     [penwidth=2 arrowhead=none]
  alt_kind -> k_rc     [penwidth=2 arrowhead=none]

  // Replicas
  minR [label="minReplicas\n(default=1)" fillcolor=white]
  maxR [label="maxReplicas"              fillcolor=white]
  replicas_grp -> minR [arrowhead=odot penwidth=1]
  replicas_grp -> maxR [penwidth=2 arrowhead=none]

  // ── MetricSpec (new v2beta1) ───────────────────────────────────────────
  metricspec [label="MetricSpec\n(array)" fillcolor="#FFE0B2" color="#E65100"]
  metrics_grp -> metricspec [arrowhead=odot penwidth=1 color="#E65100"]

  alt_type [label="△" shape=triangle fillcolor="#FFE0B2" color="#E65100" width=0.3 height=0.3]
  metricspec -> alt_type [penwidth=2 arrowhead=none color="#E65100"]

  // Metric types — all new in v2beta1
  m_resource [label="Resource"           fillcolor="#FFE0B2" color="#E65100"]
  m_object   [label="Object"             fillcolor="#FFE0B2" color="#E65100"]
  m_pods     [label="Pods"               fillcolor="#FFE0B2" color="#E65100"]
  m_external [label="External"           fillcolor="#FFE0B2" color="#E65100"]
  m_cr       [label="Container\nResource" fillcolor="#FFE0B2" color="#E65100"]

  alt_type -> m_resource [penwidth=2 arrowhead=none color="#E65100"]
  alt_type -> m_object   [penwidth=2 arrowhead=none color="#E65100"]
  alt_type -> m_pods     [penwidth=2 arrowhead=none color="#E65100"]
  alt_type -> m_external [penwidth=2 arrowhead=none color="#E65100"]
  alt_type -> m_cr       [penwidth=2 arrowhead=none color="#E65100"]

  // Resource children
  res_name   [label="name"   fillcolor="#FFE0B2" color="#E65100"]
  res_target [label="target\n(targetAverage\nUtilization)" fillcolor="#FFE0B2" color="#E65100"]
  m_resource -> res_name   [penwidth=2 arrowhead=none color="#E65100"]
  m_resource -> res_target [penwidth=2 arrowhead=none color="#E65100"]

  alt_res_name [label="△" shape=triangle fillcolor="#FFE0B2" color="#E65100" width=0.3 height=0.3]
  res_name -> alt_res_name [penwidth=2 arrowhead=none color="#E65100"]
  r_cpu [label="cpu"    fillcolor="#FFE0B2" color="#E65100"]
  r_mem [label="memory" fillcolor="#FFE0B2" color="#E65100"]
  alt_res_name -> r_cpu [penwidth=2 arrowhead=none color="#E65100"]
  alt_res_name -> r_mem [penwidth=2 arrowhead=none color="#E65100"]

  alt_target [label="△" shape=triangle fillcolor="#FFE0B2" color="#E65100" width=0.3 height=0.3]
  res_target -> alt_target [penwidth=2 arrowhead=none color="#E65100"]
  t_util [label="Utilization" fillcolor="#FFE0B2" color="#E65100"]
  t_val  [label="Value"       fillcolor="#FFE0B2" color="#E65100"]
  alt_target -> t_util [penwidth=2 arrowhead=none color="#E65100"]
  alt_target -> t_val  [penwidth=2 arrowhead=none color="#E65100"]

  // Object children
  obj_mn  [label="metricName"  fillcolor="#FFE0B2" color="#E65100"]
  obj_tv  [label="targetValue" fillcolor="#FFE0B2" color="#E65100"]
  obj_sel [label="selector"    fillcolor="#FFE0B2" color="#E65100"]
  obj_tt  [label="Target Type" fillcolor="#FFE0B2" color="#E65100"]
  m_object -> obj_mn  [penwidth=2 arrowhead=none color="#E65100"]
  m_object -> obj_tv  [penwidth=2 arrowhead=none color="#E65100"]
  m_object -> obj_sel [arrowhead=odot penwidth=1 color="#E65100"]
  m_object -> obj_tt  [penwidth=2 arrowhead=none color="#E65100"]

  alt_obj_tt [label="△" shape=triangle fillcolor="#FFE0B2" color="#E65100" width=0.3 height=0.3]
  obj_tt -> alt_obj_tt [penwidth=2 arrowhead=none color="#E65100"]
  ott_util [label="Utilization" fillcolor="#FFE0B2" color="#E65100"]
  ott_val  [label="Value"       fillcolor="#FFE0B2" color="#E65100"]
  alt_obj_tt -> ott_util [penwidth=2 arrowhead=none color="#E65100"]
  alt_obj_tt -> ott_val  [penwidth=2 arrowhead=none color="#E65100"]

  // Pods children
  pods_mn  [label="metricName"        fillcolor="#FFE0B2" color="#E65100"]
  pods_tav [label="targetAverage\nValue" fillcolor="#FFE0B2" color="#E65100"]
  pods_sel [label="selector"          fillcolor="#FFE0B2" color="#E65100"]
  m_pods -> pods_mn  [penwidth=2 arrowhead=none color="#E65100"]
  m_pods -> pods_tav [penwidth=2 arrowhead=none color="#E65100"]
  m_pods -> pods_sel [arrowhead=odot penwidth=1 color="#E65100"]

  // External children
  ext_mn  [label="metricName"    fillcolor="#FFE0B2" color="#E65100"]
  ext_ms  [label="metricSelector" fillcolor="#FFE0B2" color="#E65100"]
  ext_tt  [label="Target Type"   fillcolor="#FFE0B2" color="#E65100"]
  m_external -> ext_mn  [penwidth=2 arrowhead=none color="#E65100"]
  m_external -> ext_ms  [arrowhead=odot penwidth=1 color="#E65100"]
  m_external -> ext_tt  [penwidth=2 arrowhead=none color="#E65100"]

  alt_ext_tt [label="△" shape=triangle fillcolor="#FFE0B2" color="#E65100" width=0.3 height=0.3]
  ext_tt -> alt_ext_tt [penwidth=2 arrowhead=none color="#E65100"]
  ett_tv  [label="targetValue"        fillcolor="#FFE0B2" color="#E65100"]
  ett_tav [label="targetAverage\nValue" fillcolor="#FFE0B2" color="#E65100"]
  alt_ext_tt -> ett_tv  [penwidth=2 arrowhead=none color="#E65100"]
  alt_ext_tt -> ett_tav [penwidth=2 arrowhead=none color="#E65100"]

  // ContainerResource children
  cr_name [label="name"      fillcolor="#FFE0B2" color="#E65100"]
  cr_cont [label="container" fillcolor="#FFE0B2" color="#E65100"]
  m_cr -> cr_name [penwidth=2 arrowhead=none color="#E65100"]
  m_cr -> cr_cont [penwidth=2 arrowhead=none color="#E65100"]

  // ── status ────────────────────────────────────────────────────────────
  st_obsgen  [label="observedGeneration" fillcolor=white]
  st_last    [label="lastScaleTime"      fillcolor=white]
  st_rep     [label="Replicas Status"    fillcolor=white]
  st_cur_m   [label="Current Metrics"    fillcolor="#FFE0B2" color="#E65100"]
  st_cond    [label="Conditions"         fillcolor="#FFE0B2" color="#E65100"]

  status -> st_obsgen [arrowhead=odot penwidth=1]
  status -> st_last   [arrowhead=odot penwidth=1]
  status -> st_rep    [penwidth=2 arrowhead=none]
  status -> st_cur_m  [arrowhead=odot penwidth=1 color="#E65100"]
  status -> st_cond   [arrowhead=odot penwidth=1 color="#E65100"]

  st_cur  [label="currentReplicas" fillcolor=white]
  st_des  [label="desiredReplicas" fillcolor=white]
  st_rep -> st_cur [penwidth=2 arrowhead=none]
  st_rep -> st_des [penwidth=2 arrowhead=none]

  st_ms   [label="MetricStatus\n(array)"  fillcolor="#FFE0B2" color="#E65100"]
  st_ca   [label="Condition\n(array)"     fillcolor="#FFE0B2" color="#E65100"]
  st_cur_m -> st_ms [arrowhead=odot penwidth=1 color="#E65100"]
  st_cond  -> st_ca [arrowhead=odot penwidth=1 color="#E65100"]

  alt_cond [label="△" shape=triangle fillcolor="#FFE0B2" color="#E65100" width=0.3 height=0.3]
  st_ca -> alt_cond [penwidth=2 arrowhead=none color="#E65100"]
  c_sa [label="ScalingActive"  fillcolor="#FFE0B2" color="#E65100"]
  c_at [label="AbleToScale"    fillcolor="#FFE0B2" color="#E65100"]
  c_sl [label="ScalingLimited" fillcolor="#FFE0B2" color="#E65100"]
  alt_cond -> c_sa [penwidth=2 arrowhead=none color="#E65100"]
  alt_cond -> c_at [penwidth=2 arrowhead=none color="#E65100"]
  alt_cond -> c_sl [penwidth=2 arrowhead=none color="#E65100"]
}
