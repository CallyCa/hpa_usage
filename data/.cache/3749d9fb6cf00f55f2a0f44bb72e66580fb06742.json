[{"sha": "fc26a94aff8aef1f70a5e999bec3e7e29c95d9c0", "node_id": "C_kwDOOd0OV9oAKGZjMjZhOTRhZmY4YWVmMWY3MGE1ZTk5OWJlYzNlN2UyOWM5NWQ5YzA", "commit": {"author": {"name": "Raul", "email": "raulsantamariao@hotmail.com", "date": "2025-04-25T15:22:41Z"}, "committer": {"name": "Raul", "email": "raulsantamariao@hotmail.com", "date": "2025-04-25T15:22:41Z"}, "message": "Add Promtail configuration for Kubernetes logging\n\n- Created a ClusterRole for Promtail to access necessary Kubernetes resources.\n- Created a ClusterRoleBinding to bind the ClusterRole to the Promtail ServiceAccount.\n- Added a ConfigMap for Promtail configuration, including scrape configurations for Kubernetes pods.\n- Implemented a DaemonSet for Promtail to run on all nodes, configured to read logs from the host.\n- Created a ServiceAccount for Promtail to manage permissions within the Kubernetes cluster.\n- Updated values.yml to include client configuration for Loki and scrape configurations.", "tree": {"sha": "0371a6f11b0d8ee9d5249b2618ba0651841fe43a", "url": "https://api.github.com/repos/HSM-SANOSOFT/hsm-k3s/git/trees/0371a6f11b0d8ee9d5249b2618ba0651841fe43a"}, "url": "https://api.github.com/repos/HSM-SANOSOFT/hsm-k3s/git/commits/fc26a94aff8aef1f70a5e999bec3e7e29c95d9c0", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/HSM-SANOSOFT/hsm-k3s/commits/fc26a94aff8aef1f70a5e999bec3e7e29c95d9c0", "html_url": "https://github.com/HSM-SANOSOFT/hsm-k3s/commit/fc26a94aff8aef1f70a5e999bec3e7e29c95d9c0", "comments_url": "https://api.github.com/repos/HSM-SANOSOFT/hsm-k3s/commits/fc26a94aff8aef1f70a5e999bec3e7e29c95d9c0/comments", "author": {"login": "rsantamaria01", "id": 50458018, "node_id": "MDQ6VXNlcjUwNDU4MDE4", "avatar_url": "https://avatars.githubusercontent.com/u/50458018?v=4", "gravatar_id": "", "url": "https://api.github.com/users/rsantamaria01", "html_url": "https://github.com/rsanta