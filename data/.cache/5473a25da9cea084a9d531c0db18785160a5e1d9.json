[{"sha": "2392e3cfa02dd8ac11e23e278ff2ebfa874fc491", "node_id": "C_kwDOPwN4DNoAKDIzOTJlM2NmYTAyZGQ4YWMxMWUyM2UyNzhmZjJlYmZhODc0ZmM0OTE", "commit": {"author": {"name": "sgwrld-999", "email": "siddhant.gond22b@iiitg.ac.in", "date": "2025-09-15T11:56:15Z"}, "committer": {"name": "sgwrld-999", "email": "siddhant.gond22b@iiitg.ac.in", "date": "2025-09-15T11:56:15Z"}, "message": "feat: Add documentation and scripts for infrastructure and application management\n\n- Implement External Secrets Operator usage documentation for secure secret management.\n- Document system architecture decisions in ADRs for AWS EKS, observability stack, and security policies.\n- Create comprehensive architecture guide detailing system layers and components.\n- Add diagrams for data layer, networking, and system overview.\n- Develop operations runbook outlining deployment procedures, monitoring, and troubleshooting.\n- Document frontend architecture and build process in README.\n- Initialize frontend application with package.json and basic HTML entry point.\n- Configure Vite build tool for frontend development.\n- Document Make targets for infrastructure management and application deployment.\n- Bootstrap Helm addon charts installation script.\n- Implement secret rotation and policy validation scripts.\n- Define Terraform configurations for development and production environments.\n- Create Terraform modules for DynamoDB, ECR, EKS, IAM, and more.\n- Add scripts for local development environment management, code formatting, linting, and pre-commit checks.", "tree": {"sha": "77bffe39e920560109daf0f378c177d81ed9eadf", "url": "https://api.github.com/repos/sgwrld-999/RockPaperML/git/trees/77bffe39e920560109daf0f378c177d81ed9eadf"}, "url": "https://api.github.com/repos/sgwrld-999/RockPaperML/git/commits/2392e3cfa02dd8ac11e23e278ff2ebfa874fc491", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.