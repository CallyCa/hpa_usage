[{"sha": "4fd9110df59622708ffd4e7f77d833ffbd36a721", "node_id": "C_kwDOPPE-ctoAKDRmZDkxMTBkZjU5NjIyNzA4ZmZkNGU3Zjc3ZDgzM2ZmYmQzNmE3MjE", "commit": {"author": {"name": "Nathan Ho", "email": "72521605+cheez95@users.noreply.github.com", "date": "2025-07-28T12:08:16Z"}, "committer": {"name": "Nathan Ho", "email": "72521605+cheez95@users.noreply.github.com", "date": "2025-07-28T12:08:16Z"}, "message": "infra: production-ready Docker and Kubernetes configurations\n\n- Add docker-compose configurations for all environments\n- Create HA PostgreSQL setup with streaming replication\n- Implement Redis Sentinel for automatic failover\n- Add Kubernetes manifests for cloud deployment\n- Configure Terraform for GCP infrastructure\n- Add monitoring stack with Prometheus/Grafana\n- Implement health checks and readiness probes\n\nInfrastructure features:\n- Zero-downtime deployments\n- Automatic scaling (HPA)\n- Database backups and recovery\n- SSL/TLS termination\n- Service mesh ready\n- Observability built-in\n\nEnvironments supported:\n- Development (docker-compose.yml)\n- Testing (docker-compose.test.yml)\n- Production HA (docker-compose.prod.yml)\n- Kubernetes (k8s/*)\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "tree": {"sha": "64e9e77e00937f8d3612cd911135923ee08a5b99", "url": "https://api.github.com/repos/cheez95/LuckyGas-v3/git/trees/64e9e77e00937f8d3612cd911135923ee08a5b99"}, "url": "https://api.github.com/repos/cheez95/LuckyGas-v3/git/commits/4fd9110df59622708ffd4e7f77d833ffbd36a721", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/cheez95/LuckyGas-v3/commits/4fd9110df59622708ffd4e7f77d833ffbd36a721", "html_url": "https://github.com/cheez95/LuckyGas-v3/commit/4fd9110df59622708ffd4e7f77d833ffbd36a721", "comments_url": "https://api.github.com/repos/cheez95/LuckyGas-v3/commits/4