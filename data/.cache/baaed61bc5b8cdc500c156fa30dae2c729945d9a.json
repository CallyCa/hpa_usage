/gists{/gist_id}", "starred_url": "https://api.github.com/users/aspenas/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/aspenas/subscriptions", "organizations_url": "https://api.github.com/users/aspenas/orgs", "repos_url": "https://api.github.com/users/aspenas/repos", "events_url": "https://api.github.com/users/aspenas/events{/privacy}", "received_events_url": "https://api.github.com/users/aspenas/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "a7cd531005270a0481d107a5b1b8d4083485f800", "url": "https://api.github.com/repos/aspenas/candlefish-website/commits/a7cd531005270a0481d107a5b1b8d4083485f800", "html_url": "https://github.com/aspenas/candlefish-website/commit/a7cd531005270a0481d107a5b1b8d4083485f800"}]}, {"sha": "2e09a7dc401b1e5ddfa57d5d63932ac82781522e", "node_id": "C_kwDOPoN69NoAKDJlMDlhN2RjNDAxYjFlNWRkZmE1N2Q1ZDYzOTMyYWM4Mjc4MTUyMmU", "commit": {"author": {"name": "Patrick Smith", "email": "patrick@candlefish.ai", "date": "2025-08-22T06:23:43Z"}, "committer": {"name": "Patrick Smith", "email": "patrick@candlefish.ai", "date": "2025-08-22T06:23:43Z"}, "message": "feat: Complete NANDA platform deployment with autonomous capabilities\n\nMAJOR CHANGES:\n- Deployed NANDA AI Agent Discovery Platform to production (https://nanda.candlefish.ai)\n- Implemented 21 production AI agents from major platforms (OpenAI, Anthropic, Google, Meta)\n- Created living agent ecosystem with self-discovery and consortium formation\n- Added comprehensive test suites with Playwright E2E and unit tests\n- Implemented real-time WebSocket communication for agent coordination\n- Created billing system with tiered pricing (Developer Free to Enterprise)\n- Added monitoring dashboards with CloudWatch integration\n- Deployed to Fly.io with SSL and custom domain configuration\n\nINFRASTRUCTURE:\n- DynamoDB tables for agent registry and facts\n- GraphQL API with federation support\n- WebSocket handlers for real-time updates\n- Docker containers for all services\n- Kubernetes deployment configurations\n- Terraform infrastructure as code\n\nAGENT CAPABILITIES:\n- Self-discovery and autonomous registration\n- Consortium formation for complex tasks\n- Resource negotiation and bidding system\n- Knowledge sharing across ecosystem\n- Performance self-optimization\n\nMONITORING & OBSERVABILITY:\n- Real-time agent status dashboard\n- Performance metrics tracking\n- Error rate monitoring\n- Latency alarms\n- Grafana dashboards\n\nThis deployment represents the Internet of AI Agents going live with\nproduction-ready infrastructure for autonomous agent collaboration.\n\n\ud83e\udd16 Generated with Claude Code\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "tree": {"sha": "41120427901a8b61ce9cfc69ae2868b48211792e", "url": "https://api.github.com/repos/aspenas/candlefish-website/git/trees/41120427901a8b61ce9cfc69ae2868b48211792e"}, "url": "https://api.github.com/repos/aspenas/candlefish-website/git/commits/2e09a7dc401b1e5ddfa57d5d63932ac82781522e", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/aspenas/candlefish-website/commits/2e09a7dc401b1e5ddfa57d5d63932ac82781522e", "html_url": "https://github.com/aspenas/candlefish-website/commit/2e09a7dc401b1e5ddfa57d5d63932ac82781522e", "comments_url": "https://api.github.com/repos/aspenas/candlefish-website/commits/2e09a7dc401b1e5ddfa57d5d63932ac82781522e/comments", "author": {"login": "aspenas", "id": 25066580, "node_id": "MDQ6VXNlcjI1MDY2NTgw", "avatar_url": "https://avatars.githubusercontent.com/u/25066580?v=4", "gravatar_id": "", "url": "https://api.github.com/users/aspenas", "html_url": "https://github.com/aspenas", "followers_url": "https://api.github.com/users/aspenas/followers", "following_url": "https://api.github.com/users/aspenas/following{/other_user}", "gists_url": "https://api.github.com/users/aspena