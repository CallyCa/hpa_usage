api.github.com/users/calebbrown/following{/other_user}", "gists_url": "https://api.github.com/users/calebbrown/gists{/gist_id}", "starred_url": "https://api.github.com/users/calebbrown/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/calebbrown/subscriptions", "organizations_url": "https://api.github.com/users/calebbrown/orgs", "repos_url": "https://api.github.com/users/calebbrown/repos", "events_url": "https://api.github.com/users/calebbrown/events{/privacy}", "received_events_url": "https://api.github.com/users/calebbrown/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "web-flow", "id": 19864447, "node_id": "MDQ6VXNlcjE5ODY0NDQ3", "avatar_url": "https://avatars.githubusercontent.com/u/19864447?v=4", "gravatar_id": "", "url": "https://api.github.com/users/web-flow", "html_url": "https://github.com/web-flow", "followers_url": "https://api.github.com/users/web-flow/followers", "following_url": "https://api.github.com/users/web-flow/following{/other_user}", "gists_url": "https://api.github.com/users/web-flow/gists{/gist_id}", "starred_url": "https://api.github.com/users/web-flow/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/web-flow/subscriptions", "organizations_url": "https://api.github.com/users/web-flow/orgs", "repos_url": "https://api.github.com/users/web-flow/repos", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "received_events_url": "https://api.github.com/users/web-flow/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "b72d0b915c5680b93b40e12d8b23abcc35f1e2ec", "url": "https://api.github.com/repos/ossf/package-analysis/commits/b72d0b915c5680b93b40e12d8b23abcc35f1e2ec", "html_url": "https://github.com/ossf/package-analysis/commit/b72d0b915c5680b93b40e12d8b23abcc35f1e2ec"}]}, {"sha": "8f3fb2fad8db8c82b696752338f92a992087a5f4", "node_id": "C_kwDOFCs7JdoAKDhmM2ZiMmZhZDhkYjhjODJiNjk2NzUyMzM4ZjkyYTk5MjA4N2E1ZjQ", "commit": {"author": {"name": "Caleb Brown", "email": "calebbrown@google.com", "date": "2023-06-08T23:05:55Z"}, "committer": {"name": "GitHub", "email": "noreply@github.com", "date": "2023-06-08T23:05:55Z"}, "message": "Make workers more ephemeral to avoid space issues. (#742)\n\n* Make workers more ephemeral to avoid space issues.\r\n\r\nPreviously, prior to #172, sandbox images were cached inside the\r\nanalysis image.\r\n\r\nPR #172 solved this by using a StatefulSet to provide persistent\r\nvolumes. However, it didn't properly solve\r\nhttps://github.com/ossf/package-analysis/pull/172/files#r755697003\r\nwhere past images continued to consume the space.\r\n\r\nNow we are getting errors persistently on nodes where it is likely that\r\nthis space is fully occupied.\r\n\r\nThis change removes the persistent volume, for ephemeral storage. The\r\nemptydir ensures that data presists between crashes, but can be purged\r\nby restarting the pod.\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>\r\n\r\n* Further bump replicas\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>\r\n\r\n* Bump base replicas\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>\r\n\r\n---------\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>", "tree": {"sha": "efa2355162262c2f07db510e22b2927859b77c1d", "url": "https://api.github.com/repos/ossf/package-analysis/git/trees/efa2355162262c2f07db510e22b2927859b77c1d"}, "url": "https://api.github.com/repos/ossf/package-analysis/git/commits/8f3fb2fad8db8c82b696752338f92a992087a5f4", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsBcBAABCAAQBQJkgl7TCRBK7hj4Ov3rIwAAyHcIAFrTsr4xaB6hOcyY8sW/WjZY\njJCSzh627eQ8korTMUY0saR3ZtX4QDb+PAcBcK3eGAPexgDF2FiFvgmp7qkvVnUw\nZQvvaJyWjVtaeIdJjPiuxxoy8h+JdR94M4DWAeOj7G0z2+CSpdotHayKdA54c1wT\negs4o60AobtIeNU+BXq+3LUFxjYur8y2CMq4F5OL+emXP72UVwbAStt3PpfeVr57\nHkqqeU8KZA1sFhNBE7EiD7HedxJuolynT8wg6tIZBKUb1iqANOL//D3a+SwLR/5Z\nGoCNcY3p729SYboSiVPl0RRQaLURZ/btMe1mzYTtUJa+U8ZIBD31AiIW1fQfiwA=\n=lDfW\n-----END PGP SIGNATURE-----\n", "payload": "tree efa2355162262c2f07db510e22b2927859b77c1d\nparent fcf583b8348687867d8add6ffefa65341ad17910\nauthor Caleb Brown <calebbrown@google.com> 1686265555 +1000\ncommitter GitHub <noreply@github.com> 1686265555 +0000\n\nMake workers more ephemeral to avoid space issues. (#742)\n\n* Make workers more ephemeral to avoid space issues.\r\n\r\nPreviously, prior to #172, sandbox images were cached inside the\r\nanalysis image.\r\n\r\nPR #172 solved this by using a StatefulSet to provide persistent\r\nvolumes. However, it didn't properly solve\r\nhttps://github.com/ossf/package-analysis/pull/172/files#r755697003\r\nwhere past images continued to consume the space.\r\n\r\nNow we are getting errors persistently on nodes where it is likely that\r\nthis space is fully occupied.\r\n\r\nThis change removes the persistent volume, for ephemeral storage. The\r\nemptydir ensures that data presists between crashes, but can be purged\r\nby restarting the pod.\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>\r\n\r\n* Further bump replicas\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>\r\n\r\n* Bump base replicas\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>\r\n\r\n---------\r\n\r\nSigned-off-by: Caleb Brown <calebbrown@google.com>", "verified_at": "2024-01-16T19:59:59Z"}}, "url": "https://api.github.com/repos/ossf/package-analysis/commits/8f3fb2fad8db8c82b696752338f92a992087a5f4", "html_url": "https://github.com/ossf/package-analysis/commit/8f3fb2fad8db8c82b696752338f92a992087a5f4", "comments_url": "https://api.github.com/repos/ossf/package-analysis/commits/8f3fb2fad8db8c82b696752338f92a992087a5f4/comments", "author": {"login": "calebbrown", "id": 56095, "node_id": "MDQ6VXNlcjU2MDk1", "avatar_url": "https://avatars.githubusercontent.com/u/56095?v=4", "gravatar_id": "", "url": "https://api.github.com