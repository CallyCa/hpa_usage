[{"sha": "777457f8375e4c6d147df662a9072dc7b3f7bd81", "node_id": "C_kwDOOmZWwtoAKDc3NzQ1N2Y4Mzc1ZTRjNmQxNDdkZjY2MmE5MDcyZGM3YjNmN2JkODE", "commit": {"author": {"name": "Srivatsav Erramilli", "email": "srivatsaverramilli@gmail.com", "date": "2025-06-18T06:35:10Z"}, "committer": {"name": "Srivatsav Erramilli", "email": "srivatsaverramilli@gmail.com", "date": "2025-06-18T06:35:10Z"}, "message": "feat: Implement comprehensive resource management for Veridis deployment\n\nThis commit introduces comprehensive resource management configurations for the Veridis decentralized identity protocol deployment on Kubernetes. It includes:\n\n- Creation of `priority-classes.yaml` to define priority classes for different workloads, ensuring critical services are prioritized.\n- Creation of `limit-ranges.yaml` to enforce resource limits at container and pod levels, preventing resource exhaustion.\n- Creation of `resource-quotas.yaml` to set namespace-wide resource quotas, managing overall resource consumption.\n- Renaming `k8s/base/namespace.yaml` to `k8s/base/foundation/namespace.yaml` for better organization.\n- Updates to `k8s/base/kustomization.yaml` to include the new resource management files and comment out API gateway resources.\n- Update `README.md` to reflect the current security audit status.\n\nThese configurations provide a robust and scalable foundation for deploying Veridis, enabling efficient resource utilization, cost optimization, and compliance with industry standards.\n\nFixes #46", "tree": {"sha": "dcd166215285e736635dbf66e1d8c82e0dada211", "url": "https://api.github.com/repos/Cass402/DiD_repLayer_Starknet/git/trees/dcd166215285e736635dbf66e1d8c82e0dada211"}, "url": "https://api.github.com/repos/Cass402/DiD_repLayer_Starknet/git/commits/777457f8375e4c6d147df662a9072dc7b3f7bd81", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/Cass402/DiD_repLayer_Starknet/commits/777457f8375e4c6d147df662a9072dc7b3f7bd81", "html_url": "https://github.com/Cass402/DiD_repLayer_Starknet/commit/777457f8375e4c6d147df662a9072dc7b3f7bd81", "comments_url": "https://api.github.com/repos/Cass402/DiD_repLayer_Starknet/commits/777457f8375e4c6d147df662a9072dc7b3f7bd81/comments", "author": {"login": "Cass402", "id": 138028569, "node_id": "U_kgDOCDomGQ", "avatar_url": "https://avatars.githubusercontent.com/u/138028569?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Cass402", "html_url": "https://github.com/Cass402", "followers_url": "https://api.github.com/users/Cass402/followers", "following_url": "https://api.github.com/users/Cass402/following{/other_user}", "gists_url": "https://api.github.com/users/Cass402/gists{/gist_id}", "starred_url": "https://api.github.com/users/Cass402/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Cass402/subscriptions", "organizations_url": "https://api.github.com/users/Cass402/orgs", "repos_url": "https://api.github.com/users/Cass402/repos", "events_url": "https://api.github.com/users/Cass402/events{/privacy}", "received_events_url": "https://api.github.com/users/Cass402/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "Cass402", "id": 138028569, "node_id": "U_kgDOCDomGQ", "avatar_url": "https://avatars.githubusercontent.com/u/138028569?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Cass402", "html_url": "https://github.com/Cass402", "followers_url": "https://api.github.com/users/Cass402/followers", "following_url": "https://api.github.com/users/Cass402/following{/other_user}", "gists_url": "https://api.github.com/users/Cass402/gists{/gist_id}", "starred_url": "https://api.github.com/users/Cass402/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Cass402/subscriptions", "organizations_url": "https://api.github.com/users/Cass402/orgs", "repos_url": "https://api.gith