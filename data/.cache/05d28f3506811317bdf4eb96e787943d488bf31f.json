[{"sha": "dc9e02eccf59d9d3f9e6f2c19acb12f2309e3ce6", "node_id": "C_kwDOOx3va9oAKGRjOWUwMmVjY2Y1OWQ5ZDNmOWU2ZjJjMTlhY2IxMmYyMzA5ZTNjZTY", "commit": {"author": {"name": "Sanjeeva Reddy Dodlapati", "email": "sdodl001@odu.edu", "date": "2025-05-28T20:35:32Z"}, "committer": {"name": "Sanjeeva Reddy Dodlapati", "email": "sdodl001@odu.edu", "date": "2025-05-28T20:35:32Z"}, "message": "Implement Blue-Green Deployment Script and Comprehensive Test Suite for MetaFunction\n\n- Added a new script for blue-green deployment, enabling zero-downtime updates and instant rollback capabilities.\n- The deployment script includes functions for health checks, validation tests, and traffic switching.\n- Created a comprehensive test suite for the MetaFunction application, covering unit tests for services, integration tests, security tests, and performance tests.\n- Included mock testing for external dependencies to ensure isolated test cases.\n- Enhanced error handling and logging throughout the deployment process.", "tree": {"sha": "c81dfc954574dd2120af5a674b364e70eb83af5f", "url": "https://api.github.com/repos/sdodlapa/MetaFunction/git/trees/c81dfc954574dd2120af5a674b364e70eb83af5f"}, "url": "https://api.github.com/repos/sdodlapa/MetaFunction/git/commits/dc9e02eccf59d9d3f9e6f2c19acb12f2309e3ce6", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/sdodlapa/MetaFunction/commits/dc9e02eccf59d9d3f9e6f2c19acb12f2309e3ce6", "html_url": "https://github.com/sdodlapa/MetaFunction/commit/dc9e02eccf59d9d3f9e6f2c19acb12f2309e3ce6", "comments_url": "https://api.github.com/repos/sdodlapa/MetaFunction/commits/dc9e02eccf59d9d3f9e6f2c19acb12f2309e3ce6/comments", "author": {"login": "SanjeevaRDodlapati", "id": 54080061, "node_id": "MDQ6VXNlcjU0MDgwMDYx", "avatar_url": "https://avatars.githubusercontent.com/u/54080061?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Sanjee