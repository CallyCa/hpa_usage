[{"sha": "8f4781b0ca5ce9fdfe85dac973482cebe99a3574", "node_id": "C_kwDOOziDatoAKDhmNDc4MWIwY2E1Y2U5ZmRmZTg1ZGFjOTczNDgyY2ViZTk5YTM1NzQ", "commit": {"author": {"name": "Truong Le Vinh Phuc", "email": "truonglevinhphuc2006@gmail.com", "date": "2025-05-31T10:55:43Z"}, "committer": {"name": "Truong Le Vinh Phuc", "email": "truonglevinhphuc2006@gmail.com", "date": "2025-05-31T10:55:43Z"}, "message": "feat(k8s): Add staging configuration for Greenledger services\n\n- Created ConfigMap for environment variables and service configurations.\n- Added StatefulSets and Services for PostgreSQL databases for Calculator, Tracker, Wallet, User Auth, and Reporting services.\n- Implemented Redis deployment and service for caching.\n- Set up Kafka and Zookeeper for messaging.\n- Configured Ingress with SSL/TLS and CORS settings, including rate limiting and security headers.\n- Added Deployment and Horizontal Pod Autoscaler for Reporting service.\n- Created Secrets for sensitive data management.\n- Defined Services for Calculator, Tracker, Wallet, User Auth, and Reporting services with Prometheus annotations.\n- Removed outdated scripts for fixing module paths and CI issues.", "tree": {"sha": "a81f60b9927e95875893b1446858e8947365344d", "url": "https://api.github.com/repos/sloweyyy/GreenLedger/git/trees/a81f60b9927e95875893b1446858e8947365344d"}, "url": "https://api.github.com/repos/sloweyyy/GreenLedger/git/commits/8f4781b0ca5ce9fdfe85dac973482cebe99a3574", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/sloweyyy/GreenLedger/commits/8f4781b0ca5ce9fdfe85dac973482cebe99a3574", "html_url": "https://github.com/sloweyyy/GreenLedger/commit/8f4781b0ca5ce9fdfe85dac973482cebe99a3574", "comments_url": "https://api.github.com/repos/sloweyyy/GreenLedger/commits/8f4781b0ca5ce9fdfe85dac973482cebe99a3574/comments", "author": {"login": "sloweyyy", "id": 37492460, "node_id": "MDQ