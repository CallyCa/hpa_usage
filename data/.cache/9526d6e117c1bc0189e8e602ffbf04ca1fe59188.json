[{"sha": "78a245483080f80fc4a1e89484067a0b39aad4b6", "node_id": "C_kwDOPGRN99oAKDc4YTI0NTQ4MzA4MGY4MGZjNGExZTg5NDg0MDY3YTBiMzlhYWQ0YjY", "commit": {"author": {"name": "Lavelee954", "email": "darkhorse954@naver.com", "date": "2025-07-20T12:26:41Z"}, "committer": {"name": "Lavelee954", "email": "darkhorse954@naver.com", "date": "2025-07-20T12:26:41Z"}, "message": "Add comprehensive Kubernetes deployment environment\n\n- Complete K8s manifests replacing docker-compose setup\n- Namespace: trading-system for resource isolation\n- ConfigMaps: Configuration management for all services\n- Secrets: Secure credential management\n- Storage: Persistent volumes for data persistence\n- Infrastructure: NATS, PostgreSQL, Redis, Prometheus, Grafana\n- Applications: Go trading core and Python analysis agents\n- Networking: Ingress and network policies for security\n- Automation: Kustomize integration and deployment scripts\n- Monitoring: Full observability stack with metrics and alerting\n- Scalability: HPA for auto-scaling Python agents\n- Documentation: Comprehensive deployment and management guide\n\nThis replaces the docker-compose setup with production-ready Kubernetes environment.", "tree": {"sha": "96c3709ea50fc5db21e7b61d018a4c573bf106f6", "url": "https://api.github.com/repos/Lavelee954/software-engineering/git/trees/96c3709ea50fc5db21e7b61d018a4c573bf106f6"}, "url": "https://api.github.com/repos/Lavelee954/software-engineering/git/commits/78a245483080f80fc4a1e89484067a0b39aad4b6", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/Lavelee954/software-engineering/commits/78a245483080f80fc4a1e89484067a0b39aad4b6", "html_url": "https://github.com/Lavelee954/software-engineering/commit/78a245483080f80fc4a1e89484067a0b39aad4b6", "comments_url": "https://api.github.com/repos/Lavelee954/software-engineering/commits/78a245483080f80fc4a1e89484067a0b39aad4b6/comme