: "https://api.github.com/users/wagmarcel/subscriptions", "organizations_url": "https://api.github.com/users/wagmarcel/orgs", "repos_url": "https://api.github.com/users/wagmarcel/repos", "events_url": "https://api.github.com/users/wagmarcel/events{/privacy}", "received_events_url": "https://api.github.com/users/wagmarcel/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "KonstantinKe", "id": 40819243, "node_id": "MDQ6VXNlcjQwODE5MjQz", "avatar_url": "https://avatars.githubusercontent.com/u/40819243?v=4", "gravatar_id": "", "url": "https://api.github.com/users/KonstantinKe", "html_url": "https://github.com/KonstantinKe", "followers_url": "https://api.github.com/users/KonstantinKe/followers", "following_url": "https://api.github.com/users/KonstantinKe/following{/other_user}", "gists_url": "https://api.github.com/users/KonstantinKe/gists{/gist_id}", "starred_url": "https://api.github.com/users/KonstantinKe/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/KonstantinKe/subscriptions", "organizations_url": "https://api.github.com/users/KonstantinKe/orgs", "repos_url": "https://api.github.com/users/KonstantinKe/repos", "events_url": "https://api.github.com/users/KonstantinKe/events{/privacy}", "received_events_url": "https://api.github.com/users/KonstantinKe/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "295af9b0743451279dce5d03168654ab5f3e474c", "url": "https://api.github.com/repos/IndustryFusion/DigitalTwin/commits/295af9b0743451279dce5d03168654ab5f3e474c", "html_url": "https://github.com/IndustryFusion/DigitalTwin/commit/295af9b0743451279dce5d03168654ab5f3e474c"}]}, {"sha": "65a2b848d1a58398ae002a12ceb491b64a491de5", "node_id": "C_kwDOGKpDttoAKDY1YTJiODQ4ZDFhNTgzOThhZTAwMmExMmNlYjQ5MWI2NGE0OTFkZTU", "commit": {"author": {"name": "Marcel", "email": "wagmarcel@web.de", "date": "2022-01-21T13:44:48Z"}, "committer": {"name": "Marcel", "email": "wagmarcel@web.de", "date": "2022-01-24T15:07:48Z"}, "message": "Implement helmfile layer to manage helm dependencies\n\nThis is a major rework of the helm structure to provide a cleaner way to manage\ndependencies of the different helm charts which build the platform services.\nIt is replacing the previous split of helm charts into 1-chart and 2-chart directory.\nInstead it will now have all sub-charts in a common directory and manages the dependencies\nwith the helmfile tool.\nThe installation is described in the README.md file. Other changes:\n* Namespace is now iff per default instead of digital-twin\n* Secrets are managed by Helms lookup function to avoid overwriting secrets by updates\n* Passwords are created randomly and not expected from the helmfile.yaml or values.yaml\n* Passwords are automatically shared between the components if need be\n* Ingress is configurable for nginx and traefik ingress controller\n* The secret \"regcred\" is used for all dockerhub access\n* Realm default settings have been corrected: Confidential client for Alerta and public clients\n  for Scorpio\n\nRelated issues:\nClose #91\nSee also #90\n\nSigned-off-by: Marcel <wagmarcel@web.de>", "tree": {"sha": "eabd88be087237e11896167d8455d0cf60da3df7", "url": "https://api.github.com/repos/IndustryFusion/DigitalTwin/git/trees/eabd88be087237e11896167d8455d0cf60da3df7"}, "url": "https://api.github.com/repos/IndustryFusion/DigitalTwin/git/commits/65a2b848d1a58398ae002a12ceb491b64a491de5", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/IndustryFusion/DigitalTwin/commits/65a2b848d1a58398ae002a12ceb491b64a491de5", "html_url": "https://github.com/IndustryFusion/DigitalTwin/commit/65a2b848d1a58398ae002a12ceb491b64a491de5", "comments_url": "https://api.github.com/repos/IndustryFusion/DigitalTwin/commits/65a2b848d1a58398ae002a12ceb491b64a491de5/comments", "author":