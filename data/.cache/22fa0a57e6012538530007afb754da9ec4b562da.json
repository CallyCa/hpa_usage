[{"sha": "a05c3cf411b5efd28a3b5dd5e19f8638506bff85", "node_id": "C_kwDOGKpDttoAKGEwNWMzY2Y0MTFiNWVmZDI4YTNiNWRkNWUxOWY4NjM4NTA2YmZmODU", "commit": {"author": {"name": "Meric Feyzullahoglu", "email": "meric.feyzullahoglu@gmail.com", "date": "2023-01-20T15:02:36Z"}, "committer": {"name": "Meric Feyzullahoglu", "email": "meric.feyzullahoglu@gmail.com", "date": "2023-01-20T15:02:36Z"}, "message": "Adapt Quarkus version of Scorpio AIO to Digital Twin\n\nAdded a test profile which is enabled by default, which deploys\nAll-in-one Runner of the Quarkus version of ScorpioBroker instead\nof the distributed version for development purposes.To disable,\nrun the build script with TEST env set to FALSE, and run installation\nscript after changing aaio.enabled variable in\nDigitalTwin/helm/charts/scorpio/values file to false.\nDeployment scripts, files and tests have been adapted accordingly.\n\nCloses: #177\nCloses: Open-IoT-Service-Platform/platform-launcher#653\n\nSigned-off-by: Meric Feyzullahoglu <meric.feyzullahoglu@gmail.com>", "tree": {"sha": "9ca03f3a67ad42ef6b51a13148b87bec977a3734", "url": "https://api.github.com/repos/IndustryFusion/DigitalTwin/git/trees/9ca03f3a67ad42ef6b51a13148b87bec977a3734"}, "url": "https://api.github.com/repos/IndustryFusion/DigitalTwin/git/commits/a05c3cf411b5efd28a3b5dd5e19f8638506bff85", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\niQJSBAABCgA8FiEEDOy69AsvvYnOvU0SQgS/EVIEVjEFAmPKrTMeHG1lcmljLmZl\neXp1bGxhaG9nbHVAZ21haWwuY29tAAoJEEIEvxFSBFYx5hQQALhATpuk7o19EYbr\niOJKuFFS3cJTaAihpNjEhz9v3S98EWj2wzYiNskL8yheKV/Hs2PoxNlkT+K3Tgqs\neVJ0LSg9QXhqcztz7QyPHf6z9JmGH47S+udLfd5ooH0Yai5OPnChdEXR60XOwIOz\nrQmy165vOSEx+j90xns+/NMyoTKMS0xX+nLLHJZgpiEFXGhIecOtC16c97I9IWYw\nYH/HzLjWXQ6tz+kN9nXReQxpO2ZR9y5mFb+5IcxUxzSH3q/C4SHY4UzmGoXiSDXx\nSxWMaHk9vhNm8vzSdC2+66QIFBEqAOF7MoZcasv0AxeyDqY9nMhanSw5eSaHTuR1\nnouze7V1f2fynAPPadBIhgu6GGLw5MQi1uALuUqMgG6B7dxUkfX/PmbPagyDlTNf\n63uKZhmksEw1x21Vt+