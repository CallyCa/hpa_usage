[{"sha": "030642190f7bf80ac5737aae1b568736611afcbf", "node_id": "C_kwDOPTK-OdoAKDAzMDY0MjE5MGY3YmY4MGFjNTczN2FhZTFiNTY4NzM2NjExYWZjYmY", "commit": {"author": {"name": "Salem Yaslem", "email": "s@sy.sa", "date": "2025-07-26T15:34:14Z"}, "committer": {"name": "Salem Yaslem", "email": "s@sy.sa", "date": "2025-07-26T15:34:14Z"}, "message": "Add initial implementation of SRE Kubernetes environment\n\n- Created a comprehensive README.md outlining the project overview, architecture, and support.\n- Added failure scenarios documentation to simulate and recover from various failures in the SRE environment.\n- Developed a troubleshooting guide for common issues encountered in the Kubernetes setup.\n- Configured Kubernetes namespaces for applications, infrastructure, monitoring, and security.\n- Implemented deployments for three microservices: Main API Service (Node.js), Authentication Service (Go), and Image Storage Service (Python).\n- Set up monitoring with Prometheus and Grafana, including alerting and dashboards.\n- Established security measures with network policies and secrets management.\n- Included scripts for initializing the cluster, building images, and deploying the environment.\n- Added Dockerfiles and necessary configurations for each service to ensure proper containerization and deployment.\n- Implemented health checks and logging for all services to enhance observability and reliability.", "tree": {"sha": "04b5a4915dbae76cfefb85f9fefbe2d40bb50a72", "url": "https://api.github.com/repos/xlmnxp/thmanyah-challenge/git/trees/04b5a4915dbae76cfefb85f9fefbe2d40bb50a72"}, "url": "https://api.github.com/repos/xlmnxp/thmanyah-challenge/git/commits/030642190f7bf80ac5737aae1b568736611afcbf", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/xlmnxp/thmanyah-challenge/commits/030642190f7bf80ac5737aae1b568736611afcbf", "html_url": "https://github.com/xlm