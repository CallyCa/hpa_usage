[{"sha": "b3ada909c50b77bb3632a6eac4e83caa3694a020", "node_id": "C_kwDOPYNBrdoAKGIzYWRhOTA5YzUwYjc3YmIzNjMyYTZlYWM0ZTgzY2FhMzY5NGEwMjA", "commit": {"author": {"name": "Mukesh Kumar", "email": "155621573+mukeshkr2024@users.noreply.github.com", "date": "2025-08-16T11:33:00Z"}, "committer": {"name": "Mukesh Kumar", "email": "155621573+mukeshkr2024@users.noreply.github.com", "date": "2025-08-16T11:33:00Z"}, "message": "Implement Kubernetes deployment for CRM microservices\n\n- Added Kubernetes manifests for deploying the CRM microservices, including Auth Service, Tenant Service, Users Service, and API Gateway.\n- Configured services, deployments, and persistent storage for PostgreSQL and Redis.\n- Implemented Horizontal Pod Autoscalers (HPA) for scaling based on CPU and memory utilization.\n- Created a Kustomization file for managing the deployment resources.\n- Included setup and teardown scripts for Minikube, along with health check and build scripts for Docker images.\n- Established a namespace for resource isolation and organization within the Kubernetes cluster.", "tree": {"sha": "ca60d38fbd1633b2268e402693f1587ef8b8b283", "url": "https://api.github.com/repos/Mukeshmehta2041/crm-micro/git/trees/ca60d38fbd1633b2268e402693f1587ef8b8b283"}, "url": "https://api.github.com/repos/Mukeshmehta2041/crm-micro/git/commits/b3ada909c50b77bb3632a6eac4e83caa3694a020", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/Mukeshmehta2041/crm-micro/commits/b3ada909c50b77bb3632a6eac4e83caa3694a020", "html_url": "https://github.com/Mukeshmehta2041/crm-micro/commit/b3ada909c50b77bb3632a6eac4e83caa3694a020", "comments_url": "https://api.github.com/repos/Mukeshmehta2041/crm-micro/commits/b3ada909c50b77bb3632a6eac4e83caa3694a020/comments", "author": {"login": "mukeshkr2024", "id": 155621573, "node_id": "U_kgDOCUaYxQ", "avatar_url": "https://avatars.githubusercontent.com