[{"sha": "138bafaa782bb0878167b0c39b8f802a9974f8b8", "node_id": "C_kwDON00I1NoAKDEzOGJhZmFhNzgyYmIwODc4MTY3YjBjMzliOGY4MDJhOTk3NGY4Yjg", "commit": {"author": {"name": "Bastien Javaux", "email": "107111678+EpicSanDev@users.noreply.github.com", "date": "2025-03-18T22:19:13Z"}, "committer": {"name": "Bastien Javaux", "email": "107111678+EpicSanDev@users.noreply.github.com", "date": "2025-03-18T22:19:13Z"}, "message": "Mise \u00e0 jour du README.md et des fichiers de configuration Kubernetes pour am\u00e9liorer le d\u00e9ploiement automatique et la gestion des secrets.\n\n- Ajout d'instructions d\u00e9taill\u00e9es dans le README.md pour la configuration des secrets GitHub Actions n\u00e9cessaires au d\u00e9ploiement sur DigitalOcean Kubernetes.\n- Mise \u00e0 jour du fichier `deploy-to-kubernetes.yml` pour int\u00e9grer des variables d'environnement et automatiser la cr\u00e9ation de secrets pour le registre Docker.\n- Am\u00e9lioration du script `deploy.sh` pour inclure des v\u00e9rifications de pr\u00e9requis, la cr\u00e9ation de namespaces, et le d\u00e9ploiement des services de base (Redis, PostgreSQL).\n- Ajout de la gestion des autoscalers et des v\u00e9rifications de l'\u00e9tat des d\u00e9ploiements dans le script de d\u00e9ploiement.\n- Mise \u00e0 jour du fichier `secrets.yaml` pour inclure la configuration du secret du registre Docker.", "tree": {"sha": "22a559008552c876f16ae52aa68fb93e6faf77a2", "url": "https://api.github.com/repos/EpicSanDev/EVIL2ROOT_AI-main/git/trees/22a559008552c876f16ae52aa68fb93e6faf77a2"}, "url": "https://api.github.com/repos/EpicSanDev/EVIL2ROOT_AI-main/git/commits/138bafaa782bb0878167b0c39b8f802a9974f8b8", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/EpicSanDev/EVIL2ROOT_AI-main/commits/138bafaa782bb0878167b0c39b8f802a9974f8b8", "html_url": "https://github.com/EpicSanDev/EVIL2ROOT_AI-main/commit/138bafaa7