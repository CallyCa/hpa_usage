[{"sha": "353759bb30ec8fcabfd8e437fe35f407f15b5641", "node_id": "MDY6Q29tbWl0NzY4ODA4MTQ6MzUzNzU5YmIzMGVjOGZjYWJmZDhlNDM3ZmUzNWY0MDdmMTViNTY0MQ==", "commit": {"author": {"name": "Damien Grisonnet", "email": "dgrisonn@redhat.com", "date": "2021-07-29T11:44:26Z"}, "committer": {"name": "Damien Grisonnet", "email": "dgrisonn@redhat.com", "date": "2021-07-29T11:55:59Z"}, "message": "gen-apidocs: update events api to events.k8s.io\n\nIn Kubernetes v1.19, the new Events API events.k8s.io was promoted to\nv1. As such it now supersedes the original core Events API. Since this\nwasn't defined in this project, the official kubernetes-api doc was\nputting the events.k8s.io API under the list of old APIs and the\nrecommended API for Events was still the core one. To fix that, we need\nto define that the events API group is newer than the core one.\n\nSigned-off-by: Damien Grisonnet <dgrisonn@redhat.com>", "tree": {"sha": "db194743444b4416359924b79685c54db319f7a4", "url": "https://api.github.com/repos/kubernetes-sigs/reference-docs/git/trees/db194743444b4416359924b79685c54db319f7a4"}, "url": "https://api.github.com/repos/kubernetes-sigs/reference-docs/git/commits/353759bb30ec8fcabfd8e437fe35f407f15b5641", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/kubernetes-sigs/reference-docs/commits/353759bb30ec8fcabfd8e437fe35f407f15b5641", "html_url": "https://github.com/kubernetes-sigs/reference-docs/commit/353759bb30ec8fcabfd8e437fe35f407f15b5641", "comments_url": "https://api.github.com/repos/kubernetes-sigs/reference-docs/commits/353759bb30ec8fcabfd8e437fe35f407f15b5641/comments", "author": {"login": "dgrisonnet", "id": 22327577, "node_id": "MDQ6VXNlcjIyMzI3NTc3", "avatar_url": "https://avatars.githubusercontent.com/u/22327577?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dgrisonnet", "html_url": "https://github.com/dgrisonnet", "followers_ur