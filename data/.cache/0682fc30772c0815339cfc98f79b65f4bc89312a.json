[{"sha": "03b235703b2eb23d4c78eea12a6f77b9bbdb969a", "node_id": "C_kwDOPvW6tNoAKDAzYjIzNTcwM2IyZWIyM2Q0Yzc4ZWVhMTJhNmY3N2I5YmJkYjk2OWE", "commit": {"author": {"name": "Jun Kawasaki", "email": "j.kawasaki@gftd.co.jp", "date": "2025-09-14T17:26:51Z"}, "committer": {"name": "Jun Kawasaki", "email": "j.kawasaki@gftd.co.jp", "date": "2025-09-14T17:26:51Z"}, "message": "Implement GKE deployment for Kotoba with Kubernetes resources\n\n- Added a Dockerfile for building the Kotoba application.\n- Created Kubernetes manifests including StatefulSet, Services, ConfigMap, and Ingress for deploying Kotoba on GKE.\n- Introduced autoscaling configuration and a deployment script for streamlined GKE setup.\n- Updated version of `kotoba2tsx` to 0.1.2 in `Cargo.toml` and `Cargo.lock` to reflect the latest changes.\n- Enhanced README documentation for GKE deployment instructions and usage.", "tree": {"sha": "843f82a2cc8922f2eb6d77d2b00fd3d348ec503f", "url": "https://api.github.com/repos/com-junkawasaki/kotoba/git/trees/843f82a2cc8922f2eb6d77d2b00fd3d348ec503f"}, "url": "https://api.github.com/repos/com-junkawasaki/kotoba/git/commits/03b235703b2eb23d4c78eea12a6f77b9bbdb969a", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/com-junkawasaki/kotoba/commits/03b235703b2eb23d4c78eea12a6f77b9bbdb969a", "html_url": "https://github.com/com-junkawasaki/kotoba/commit/03b235703b2eb23d4c78eea12a6f77b9bbdb969a", "comments_url": "https://api.github.com/repos/com-junkawasaki/kotoba/commits/03b235703b2eb23d4c78eea12a6f77b9bbdb969a/comments", "author": null, "committer": null, "parents": [{"sha": "4e882a6e1f015ea527d6efda03c4bf2a2a05dbdd", "url": "https://api.github.com/repos/com-junkawasaki/kotoba/commits/4e882a6e1f015ea527d6efda03c4bf2a2a05dbdd", "html_url": "https://github.com/com-junkawasaki/kotoba/commit/4e882a6e1f015ea527d6efda03c4bf2a2a05dbdd"}]}]