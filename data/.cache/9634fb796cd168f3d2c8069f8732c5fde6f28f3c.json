[{"sha": "9ecea1514960d5df10756f0409ca7919ecefa7af", "node_id": "C_kwDONSr5yNoAKDllY2VhMTUxNDk2MGQ1ZGYxMDc1NmYwNDA5Y2E3OTE5ZWNlZmE3YWY", "commit": {"author": {"name": "David Gardiner", "email": "davidmarkgardiner@gmail.com", "date": "2025-08-13T10:54:06Z"}, "committer": {"name": "David Gardiner", "email": "davidmarkgardiner@gmail.com", "date": "2025-08-13T10:54:06Z"}, "message": "Add ConfigMap and Deployment for AKS Platform Demo\n\n- Introduced a new ConfigMap for serving HTML content in the AKS platform demo, including a detailed presentation structure with slides covering various aspects of the platform.\n- Added a Deployment configuration for the demo application, specifying resource limits, security contexts, and health checks.\n- Implemented a Service to expose the demo application, along with Istio configurations for VirtualService and Gateway to manage traffic.\n- Included a HorizontalPodAutoscaler for dynamic scaling based on resource utilization, enhancing the demo's performance and reliability.\n- Aimed to provide a comprehensive and interactive demonstration of the shared AKS platform capabilities.", "tree": {"sha": "5a6a42417d43bf4a6199d9f55671960120b76970", "url": "https://api.github.com/repos/davidmarkgardiner/scratchpad/git/trees/5a6a42417d43bf4a6199d9f55671960120b76970"}, "url": "https://api.github.com/repos/davidmarkgardiner/scratchpad/git/commits/9ecea1514960d5df10756f0409ca7919ecefa7af", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/davidmarkgardiner/scratchpad/commits/9ecea1514960d5df10756f0409ca7919ecefa7af", "html_url": "https://github.com/davidmarkgardiner/scratchpad/commit/9ecea1514960d5df10756f0409ca7919ecefa7af", "comments_url": "https://api.github.com/repos/davidmarkgardiner/scratchpad/commits/9ecea1514960d5df10756f0409ca7919ecefa7af/comments", "author": {"login": "davidmarkgardiner", "id": 19332774, "node_id": "