[{"sha": "acf56ada727e522dde1bb7a9368d42f7deddb039", "node_id": "C_kwDOPlNal9oAKGFjZjU2YWRhNzI3ZTUyMmRkZTFiYjdhOTM2OGQ0MmY3ZGVkZGIwMzk", "commit": {"author": {"name": "User", "email": "user@example.com", "date": "2025-08-27T14:51:31Z"}, "committer": {"name": "User", "email": "user@example.com", "date": "2025-08-27T14:51:31Z"}, "message": "Add audio file analyzer and XOR utilities to Plugin.Shared\n\n- Added AudioFileAnalyzer utility for analyzing WAV, FLAC, AMR/AWB file headers\n  - Extracts channels, duration, sample rate, and format information\n  - Works with byte content from FileCacheDataObject (not file paths)\n  - Uses NAudio for WAV files, manual parsing for FLAC and AMR formats\n\n- Added XorUtility for XOR operations on byte data\n  - Supports single byte, byte array, and string keys\n  - Includes in-place operations and checksum calculation\n  - Designed for encryption/decryption of file content from cache\n\n- Added FileCacheDataHelper utility for working with FileCacheDataObject\n  - Simplifies extraction of file content and metadata from cache structures\n  - Provides direct audio analysis and XOR operations on cached content\n  - Handles base64 decoding and JSON parsing automatically\n\n- Updated project dependencies to include NAudio (2.2.1)\n- Added comprehensive examples and documentation\n- All utilities are thread-safe and include correlation-aware logging", "tree": {"sha": "72422bd5923d7b083371d32ceb87e28eaf6f5ac6", "url": "https://api.github.com/repos/kataniwayou/Design82/git/trees/72422bd5923d7b083371d32ceb87e28eaf6f5ac6"}, "url": "https://api.github.com/repos/kataniwayou/Design82/git/commits/acf56ada727e522dde1bb7a9368d42f7deddb039", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/kataniwayou/Design82/commits/acf56ada727e522dde1bb7a9368d42f7deddb039", "html_url": "https://github.com/kataniwayou/Design82/commit/acf56ada