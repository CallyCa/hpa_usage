[{"sha": "2081ad36e725ed6a1370ce713bda8b14799a9679", "node_id": "C_kwDOPoUQ1toAKDIwODFhZDM2ZTcyNWVkNmExMzcwY2U3MTNiZGE4YjE0Nzk5YTk2Nzk", "commit": {"author": {"name": "deekshith-b48", "email": "deekshithb.22cs038.nc@cambridge.edu.in", "date": "2025-09-02T10:20:30Z"}, "committer": {"name": "deekshith-b48", "email": "deekshithb.22cs038.nc@cambridge.edu.in", "date": "2025-09-02T10:22:06Z"}, "message": "feat: Initial commit - Poligap AI-Powered Legal Compliance Platform\n\nComplete Next.js application featuring:\n- \ud83c\udfdb\ufe0f Legal compliance checking (HIPAA, GDPR, CCPA, SOX, PCI DSS, ISO 27001)\n- \ud83d\udcc4 AI-powered contract analysis and review\n- \ud83e\udd16 Specialized AI agents for legal assistance\n- \ud83d\udcca Real-time analytics and compliance dashboard\n- \ud83d\udd0d Enterprise search across documents\n- \ud83d\udcac Interactive chat with legal AI\n- \ud83d\udd10 Role-based access control with PropelAuth\n- \ud83d\udcf1 Responsive design with Tailwind CSS\n- \ud83d\ude80 Modern tech stack: Next.js 15, React 19, TypeScript 5\n- \ud83d\uddc4\ufe0f Database: MongoDB with Redis caching\n- \u2601\ufe0f Cloud storage: AWS S3 integration\n- \ud83d\udc33 Docker & Kubernetes ready\n- \ud83d\udcdd Comprehensive documentation and deployment guides\n- \ud83d\udd12 Security: Removed sensitive .env file and added .env.example", "tree": {"sha": "3e67a1196b58cac75341f2ceba830699fea3eece", "url": "https://api.github.com/repos/deekshith-b48/poligap-kroolo/git/trees/3e67a1196b58cac75341f2ceba830699fea3eece"}, "url": "https://api.github.com/repos/deekshith-b48/poligap-kroolo/git/commits/2081ad36e725ed6a1370ce713bda8b14799a9679", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/deekshith-b48/poligap-kroolo/commits/2081ad36e725ed6a1370ce713bda8b14799a9679", "html_url": "https://github.com/deekshith-b48/poligap-kroolo/commit/2081ad36e725ed6a1370