[{"sha": "8e6da32e5488ea4058381fb3232d7f5caf4bb4f3", "node_id": "C_kwDOPLGnVtoAKDhlNmRhMzJlNTQ4OGVhNDA1ODM4MWZiMzIzMmQ3ZjVjYWY0YmI0ZjM", "commit": {"author": {"name": "Paul Greenwood", "email": "poglesbyg@gmail.com", "date": "2025-07-17T14:47:18Z"}, "committer": {"name": "Paul Greenwood", "email": "poglesbyg@gmail.com", "date": "2025-07-17T14:47:18Z"}, "message": "Enhance Nanopore Tracking App with Tailwind CSS Integration and Improved Error Handling\n\n- Added Tailwind CSS integration to the Astro configuration for improved styling capabilities.\n- Updated TypeScript configuration to extend from the strictest settings, enhancing type safety.\n- Refined Dockerfile for optimized dependency installation using pnpm.\n- Enhanced OpenShift deployment configuration by switching to binary source type and removing unnecessary triggers.\n- Implemented persistent volume claims for better data management in the deployment.\n- Improved error handling in the PDF upload and extraction processes, ensuring robust user feedback.\n- Updated various components to utilize new error handling and formatting functions for better user experience.\n\nThis commit lays the groundwork for a more responsive and visually appealing application while ensuring data integrity and user-friendly error management.", "tree": {"sha": "280537000cb7066840c3d1795d20d92dafb51477", "url": "https://api.github.com/repos/poglesbyg/tracseq_ON/git/trees/280537000cb7066840c3d1795d20d92dafb51477"}, "url": "https://api.github.com/repos/poglesbyg/tracseq_ON/git/commits/8e6da32e5488ea4058381fb3232d7f5caf4bb4f3", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/poglesbyg/tracseq_ON/commits/8e6da32e5488ea4058381fb3232d7f5caf4bb4f3", "html_url": "https://github.com/poglesbyg/tracseq_ON/commit/8e6da32e5488ea4058381fb3232d7f5caf4bb4f3", "comments_url": "https://api.github.com/repos/poglesbyg/tracseq_O