acy}", "received_events_url": "https://api.github.com/users/tjololo/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "web-flow", "id": 19864447, "node_id": "MDQ6VXNlcjE5ODY0NDQ3", "avatar_url": "https://avatars.githubusercontent.com/u/19864447?v=4", "gravatar_id": "", "url": "https://api.github.com/users/web-flow", "html_url": "https://github.com/web-flow", "followers_url": "https://api.github.com/users/web-flow/followers", "following_url": "https://api.github.com/users/web-flow/following{/other_user}", "gists_url": "https://api.github.com/users/web-flow/gists{/gist_id}", "starred_url": "https://api.github.com/users/web-flow/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/web-flow/subscriptions", "organizations_url": "https://api.github.com/users/web-flow/orgs", "repos_url": "https://api.github.com/users/web-flow/repos", "events_url": "https://api.github.com/users/web-flow/events{/privacy}", "received_events_url": "https://api.github.com/users/web-flow/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "1340b62dde7d1e20faffe51a44ac16263c970ee1", "url": "https://api.github.com/repos/Altinn/altinn-studio-charts/commits/1340b62dde7d1e20faffe51a44ac16263c970ee1", "html_url": "https://github.com/Altinn/altinn-studio-charts/commit/1340b62dde7d1e20faffe51a44ac16263c970ee1"}]}, {"sha": "03af942a5b125d914f4f68d1fee25564bb136fb7", "node_id": "C_kwDOFrqhmNoAKDAzYWY5NDJhNWIxMjVkOTE0ZjRmNjhkMWZlZTI1NTY0YmIxMzZmYjc", "commit": {"author": {"name": "Vemund Gaukstad", "email": "tjololo@users.noreply.github.com", "date": "2021-10-15T14:54:29Z"}, "committer": {"name": "GitHub", "email": "noreply@github.com", "date": "2021-10-15T14:54:29Z"}, "message": "Horizontal Pod Autoscaler (#3)\n\n## Changes \r\n* Replace name with fullname for labels and selectors\r\n\r\n      HPA use labels to identify pods for scaling.\r\n        \r\n      Using only name, HPA would calculated CPU/MEM usage for all pods deployed with this chart\r\n* Add resource requests all deployments\r\n\r\n      for application container defaults are cpu: 300 millicores, memory: 256Mi\r\n      for linkerd container requests are set to cpu: 100 millicores, memory: 20Mi. Limit memory: 250Mi\r\n      linkerd values sourced from helm chart ha-mode defaults*\r\n* Add horizontal pod autoscaler \r\n\r\n      add requests for all containers including containers injected by linkerd\r\n      scaling options exposed in values.yaml\r\n      add opt-out HPA configuration\r\n* Rename deployment object in kubernetes\r\n\r\n      deployment is given a postfix `-v2` due to changes in selectors (immutable)\r\n\r\n* New major version\r\n\r\n      changing selectors require uninstall and install as fields are immutable. \r\n      To solve this the deployment is postfixed with -v2 to force creation of new object in kubernetes. \r\n      This may lead to a short period of downtime.\r\n\r\n## Links:\r\n* [linkerd ha-mode defaults](https://github.com/linkerd/linkerd2/blob/main/charts/linkerd2/values-ha.yaml)", "tree": {"sha": "6a0f819d4b8a95580298a167c12b2655f564c918", "url": "https://api.github.com/repos/Altinn/altinn-studio-charts/git/trees/6a0f819d4b8a95580298a167c12b2655f564c918"}, "url": "https://api.github.com/repos/Altinn/altinn-studio-charts/git/commits/03af942a5b125d914f4f68d1fee25564bb136fb7", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsBcBAABCAAQBQJhaZYlCRBK7hj4Ov3rIwAAe38IAHOAOPvu/yu5QOF5VoUIumX5\niHHvFJ7lOTxV3Ju6jfi40aiAe+11btQAe7uPqgcCWJOq8cJMxEW7tQ+lyYFIKo9+\ntUP3qkvfZA9XPVQymlSZ7ZCRaccfnLlvnDir4gLuWlsFXWRNLXeAsZeop48pZgzN\nZ/Bsu/B3mvFekpo1FXxdBNHnZw7tEstt5scfn8I6LY7At67rgXemU6+ttrnxbQFy\nIxey8tsklOMZJUAfnQ5XQna2upuA6KFvnod7vrv11hL7LelomKE+TBPCbVRv0vQB\n0IMAtPpAb6jfGxqx/RpPgWHzhI1DRauEZ4fSDXalwHMNcEe4eKVbenYL6tGeWa0=\n=dcep\n-----END PGP SIGNATURE-----\n", "payload": "tree 6a0f819d4b8a95580298a167c12b2655f564c918\nparent 1fcb735115d241bf817ff6eb318a7f504fa51da5\nauthor Vemund Gaukstad <tjololo@users.noreply.github.com> 1634309669 +0200\ncommitter GitHub <noreply@github.com> 1634309669 +0200\n\nHorizontal Pod Autoscaler (#3)\n\n## Changes \r\n* Replace name with fullname for labels and selectors\r\n\r\n      HPA use labels to identify pods for scaling.\r\n        \r\n      Using only name, HPA would calculated CPU/MEM usage for all pods deployed with this chart\r\n* Add resource requests all deployments\r\n\r\n      for application container defaults are cpu: 300 millicores, memory: 256Mi\r\n      for linkerd container requests are set to cpu: 100 millicores, memory: 20Mi. Limit memory: 250Mi\r\n      linkerd values sourced from helm chart ha-mode defaults*\r\n* Add horizontal pod autoscaler \r\n\r\n      add requests for all containers including containers injected by linkerd\r\n      scaling options exposed in values.yaml\r\n      add opt-out HPA configuration\r\n* Rename deployment object in kubernetes\r\n\r\n      deployment is given a postfix `-v2` due to changes in selectors (immutable)\r\n\r\n* New major version\r\n\r\n      changing selectors require uninstall and install as fields are immutable. \r\n      To solve this the deployment is postfixed with -v2 to force creation of new object in kubernetes. \r\n      This may lead to a short period of downtime.\r\n\r\n## Links:\r\n* [linkerd ha-mode defaults](https://github.com/linkerd/linkerd2/blob/main/charts/linkerd2/values-ha.yaml)", "verified_at": "2024-01-16T19:59:59Z"}}, "url": "https://api.github.com/repos/Altinn/altinn-studio-charts/commits/03af942a5b125d914f4f68d1fee25564bb136fb7", "html_url": "https://github.com/Altinn/altinn-studio-charts/commit/03af942a5b125d914f4f68d1fee25564bb136fb7", "comments_url": "https://api.github.com/repos/Altinn/altinn-studio-charts/commits/03af942a5b125d914f4f68d1fee25564bb136fb7/comments", "author": {"login": "tjololo", "id": 1145298, "node_id": 