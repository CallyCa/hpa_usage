[{"sha": "e2ec127321d793fe29b25bba83d3c7563723c17f", "node_id": "C_kwDOPqgwUtoAKGUyZWMxMjczMjFkNzkzZmUyOWIyNWJiYTgzZDNjNzU2MzcyM2MxN2Y", "commit": {"author": {"name": "Adrian Castellar", "email": "adriancst16@gmail.com", "date": "2025-09-06T19:57:49Z"}, "committer": {"name": "Adrian Castellar", "email": "adriancst16@gmail.com", "date": "2025-09-06T19:57:49Z"}, "message": "feat: Initialize Supabase Kubernetes IaC for Azure\n\nInitial commit of automated, production-grade deployment infrastructure for Supabase on Kubernetes using code-based IaC (CDKTF) for Azure.\n\nChanges include:\n- Updated README with detailed repo structure and implementation overview\n- Added .gitignore for proper version control exclusion\n- Created infra/ directory with CDKTF (Python) skeleton for Azure infrastructure components (VNet, AKS, PostgreSQL Flexible Server, Storage, Key Vault)\n- Added k8s/ directory with Kubernetes manifests (External Secrets, HPA, NetworkPolicy, Ingress, Namespace)\n- Included helm/ directory with Supabase Helm values tailored for AKS and external services\n- Added scripts/ directory with PowerShell scripts for deployment, destruction, and smoke testing\n- Created documentation structure in docs/ with implementation plans and diagram placeholders\n\nThis establishes the complete foundation for deploying Supabase on Azure Kubernetes Service with secure secrets management and scalable cloud-native architecture.", "tree": {"sha": "a06a8468278b5eccf6c4c3b8a81ec72e4d737490", "url": "https://api.github.com/repos/AdrianCsT/supabase-k8s-iac/git/trees/a06a8468278b5eccf6c4c3b8a81ec72e4d737490"}, "url": "https://api.github.com/repos/AdrianCsT/supabase-k8s-iac/git/commits/e2ec127321d793fe29b25bba83d3c7563723c17f", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/AdrianCsT/supabase-k8s-iac/commits/e2ec127321d793fe29b25bba83d3c7563723c17f", "html_url": "h