[{"sha": "75235999fbbbe2c63546d8e0bc99e83980955d8b", "node_id": "C_kwDOPXpfdNoAKDc1MjM1OTk5ZmJiYmUyYzYzNTQ2ZDhlMGJjOTllODM5ODA5NTVkOGI", "commit": {"author": {"name": "Daniel Schmidt", "email": "danschmidt88@gmail.com", "date": "2025-08-07T04:13:47Z"}, "committer": {"name": "Daniel Schmidt", "email": "danschmidt88@gmail.com", "date": "2025-08-07T04:13:47Z"}, "message": "feat(deployment): add production Kubernetes manifests and deployment documentation\n\n- Add Kubernetes manifests for namespace, configmap, secrets, deployment, statefulsets, services, ingress, HPA, RBAC, and monitoring\n- Provide detailed production deployment guide in docs/DEPLOYMENT.md\n- Include configuration, scaling, security, monitoring, troubleshooting, and maintenance instructions\n- Establish production-grade setup for Self-Healing MLOps Bot with auto-scaling, TLS, and observability\n- Enhance architecture documentation with updated system overview and components\n- Add comprehensive API documentation covering webhook, management, issues, playbooks, metrics, and security\n- Implement new automated repair actions for code fixes, config updates, notifications, retraining, and rollback\n- Introduce security validation system for input and webhook payloads\n\nThis commit sets up the foundation for deploying and operating the bot in a robust production environment.\n\nCo-authored-by: terragon-labs[bot] <terragon-labs[bot]@users.noreply.github.com>", "tree": {"sha": "8a5e8319b004f535686e3b9dcb936450dabc845c", "url": "https://api.github.com/repos/danieleschmidt/self-healing-mlops-bot/git/trees/8a5e8319b004f535686e3b9dcb936450dabc845c"}, "url": "https://api.github.com/repos/danieleschmidt/self-healing-mlops-bot/git/commits/75235999fbbbe2c63546d8e0bc99e83980955d8b", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/danieleschmidt/self-healing-mlops-bot/commits/75235999fbbbe2c635