[{"sha": "68be4b72781c2771906a73d509599ff7bbb7a2be", "node_id": "C_kwDOP2HYOtoAKDY4YmU0YjcyNzgxYzI3NzE5MDZhNzNkNTA5NTk5ZmY3YmJiN2EyYmU", "commit": {"author": {"name": "Ricardo Lima", "email": "ricardoslima2009@hotmail.com", "date": "2025-10-07T20:58:13Z"}, "committer": {"name": "Ricardo Lima", "email": "ricardoslima2009@hotmail.com", "date": "2025-10-07T20:58:13Z"}, "message": "feat: Update Istio security configuration for strict mTLS and enhance authorization policies\n\ndocs: Revise GitHub Actions guide for improved clarity and structure\n\nfeat: Implement canary progressive delivery strategy with enhanced metrics for Orders, Payments, and API Gateway\n\nrefactor: Improve manifest generation script for better readability and maintainability\n\nfix: Correct formatting issues in deployment, service, and destination rule templates\n\nchore: Add quick start workflows documentation for GitHub Actions deployment processes", "tree": {"sha": "dde97a81ee3040aa293912f17bd5f4543b07f886", "url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/git/trees/dde97a81ee3040aa293912f17bd5f4543b07f886"}, "url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/git/commits/68be4b72781c2771906a73d509599ff7bbb7a2be", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/commits/68be4b72781c2771906a73d509599ff7bbb7a2be", "html_url": "https://github.com/ricardo2009/istio-aks-templates/commit/68be4b72781c2771906a73d509599ff7bbb7a2be", "comments_url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/commits/68be4b72781c2771906a73d509599ff7bbb7a2be/comments", "author": {"login": "ricardo2009", "id": 47871470, "node_id": "MDQ6VXNlcjQ3ODcxNDcw", "avatar_url": "https://avatars.githubusercontent.com/u/47871470?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ricardo2009", "html_url": "https://git