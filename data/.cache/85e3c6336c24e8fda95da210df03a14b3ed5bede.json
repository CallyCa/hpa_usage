.com/ricardo2009/istio-aks-templates/commit/c67745f8e6790a24cf39f560bb83e67a4c21611e"}]}, {"sha": "c67745f8e6790a24cf39f560bb83e67a4c21611e", "node_id": "C_kwDOP2HYOtoAKGM2Nzc0NWY4ZTY3OTBhMjRjZjM5ZjU2MGJiODNlNjdhNGMyMTYxMWU", "commit": {"author": {"name": "Ricardo Lima", "email": "ricardoslima2009@hotmail.com", "date": "2025-10-07T20:52:16Z"}, "committer": {"name": "Ricardo Lima", "email": "ricardoslima2009@hotmail.com", "date": "2025-10-07T20:52:16Z"}, "message": "feat(manifest-generator): Implement Kubernetes manifest generator script\n\n- Added a new script `generate-manifests.py` to generate Kubernetes manifests from parameterized YAML configuration files.\n- The script supports generating Deployment, Service, HorizontalPodAutoscaler, PodDisruptionBudget, ServiceAccount, Istio DestinationRule, VirtualService, and NetworkPolicy.\n- Introduced command-line arguments for environment, applications, configuration directory, and output directory.\n- Enhanced deployment configurations with security contexts, probes, and resource management.\n\nfeat(eastwest-gateways): Create installation script for East-West Gateways\n\n- Added `install-eastwest-gateways.sh` script to install East-West Gateways for cross-cluster Istio.\n- The script handles the deployment of the East-West Gateway, including Service, Deployment, ServiceAccount, and RBAC roles.\n- It waits for the deployment to be available and retrieves the service IPs for both primary and secondary clusters.\n\nchore(manifest-templates): Add manifest templates for various Kubernetes resources\n\n- Created template files for Deployment, Service, HPA, PDB, DestinationRule, VirtualService, and KEDA ScaledObject.\n- Templates utilize placeholders for dynamic values such as app name, namespace, image tags, and resource limits.\n- Enhanced templates with annotations for Prometheus scraping and health checks.", "tree": {"sha": "44beb9b05773e244ec852b75c43ba590242103ca", "url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/git/trees/44beb9b05773e244ec852b75c43ba590242103ca"}, "url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/git/commits/c67745f8e6790a24cf39f560bb83e67a4c21611e", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/commits/c67745f8e6790a24cf39f560bb83e67a4c21611e", "html_url": "https://github.com/ricardo2009/istio-aks-templates/commit/c67745f8e6790a24cf39f560bb83e67a4c21611e", "comments_url": "https://api.github.com/repos/ricardo2009/istio-aks-templates/commits/c67745f8e6790a24cf39f560bb83e67a4c21611e/comments", "author": {"login": "ricardo2009", "id": 47871470, "node_id": "MDQ6VXNlcjQ3ODcxNDcw", "avatar_url": "https://avatars.githubusercontent.com/u/47871470?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ricardo2009", "html_url": "https://github.com/ricardo2009", "followers_url": "https://api.github.com/users/ricardo2009/followers", "following_url": "https://api.github.com/users/ricardo2009/following{/other_user}", "gists_url": "https://api.github.com/users/ricardo2009/gists{/gist_id}", "starred_url": "https://api.github.com/users/ricardo2009/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ricardo2009/subscriptions", "organizations_url": "https://api.github.com/users/ricardo2009/orgs", "repos_url": "https://api.github.com/users/ricardo2009/repos", "events_url": "https://api.github.com/users/ricardo2009/events{/privacy}", "received_events_url": "https://api.github.com/users/ricardo2009/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "ricardo2009", "id": 47871470, "node_id": "MDQ6VXNlcjQ3ODcxNDcw", "avatar_url": "https://avatars.githubusercontent.com/u/47871470?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ricardo2009", "html_url": "https://github.com/ricardo2009", "follow