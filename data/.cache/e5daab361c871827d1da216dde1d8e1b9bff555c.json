[{"sha": "38af8f091c609ed3e12054eea2a8d63364e96509", "node_id": "MDY6Q29tbWl0MTkyMzYyNzA2OjM4YWY4ZjA5MWM2MDllZDNlMTIwNTRlZWEyYThkNjMzNjRlOTY1MDk=", "commit": {"author": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-10-15T07:34:58Z"}, "committer": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-10-15T07:35:07Z"}, "message": "fix(bug): enable GPTBasedUUID ndm feature flag by default\n\nThis PR enables GPTBasedUUID ndm feature flag by default for OpenEBS version\n2.0.0 and 2.0.0-ee.\n\nSigned-off-by: sagarkrsd <sagar.kumar@mayadata.io>", "tree": {"sha": "28d95e74be613c69474359efa24b2856e5e48d0f", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/trees/28d95e74be613c69474359efa24b2856e5e48d0f"}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/commits/38af8f091c609ed3e12054eea2a8d63364e96509", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/38af8f091c609ed3e12054eea2a8d63364e96509", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/38af8f091c609ed3e12054eea2a8d63364e96509", "comments_url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/38af8f091c609ed3e12054eea2a8d63364e96509/comments", "author": null, "committer": null, "parents": [{"sha": "a844959c02fc75d518d50c27b88d4bdb0a19df6e", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/a844959c02fc75d518d50c27b88d4bdb0a19df6e", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/a844959c02fc75d518d50c27b88d4bdb0a19df6e"}]}, {"sha": "6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "node_id": "MDY6Q29tbWl0MTkyMzYyNzA2OjZlM2NhOGQxNmI2NmUwNTI2YmQ1N2Q1Y2Q5YjQ1NDM4YWEzMTRlZDE=", "commit": {"author": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-09-22T04:06:16Z"}, "committer": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-09-22T04:06:23Z"}, "message": "fix(bug): fix upgrade issue after adoption\n\nThis PR fixes the following upgrade issue after adoption:\n1. Immutability error due to label selector\n2. Immutability error due to some envs such as OPENEBS_NAMESPACE.\n3. Issue due to container name difference in helm and operator way of installation.\n\nThis PR also adds:\n1. Update installer type from openebs-operator to openebs-enterprise-operator for google analytics.\n\nIt also does some refactoring wrt update logic of pod templates, label selector, etc.\n\nSigned-off-by: sagarkrsd <sagar.kumar@mayadata.io>", "tree": {"sha": "dfb00e8e85b1724a1f0b455b53d6a0eefc6cd1fb", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/trees/dfb00e8e85b1724a1f0b455b53d6a0eefc6cd1fb"}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/commits/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "comments_url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1/comments", "author": null, "committer": null, "parents": [{"sha": "cb94a6b32c42ea6a6440346751eab054b797a4cb", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/cb94a6b32c42ea6a6440346751eab054b797a4cb", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/cb94a6b32c42ea6a6440346751eab054b797a4cb"}]}, {"sha": "5f583b4db3a23dd4aa09735eda00534a1a216a67", "node_id": "MDY6Q29tbWl0MTkyMzYyNzA2OjVmNTgzYjRkYjNhMjNkZDRhYTA5NzM1ZWRhMDA1MzRhMWEyMTZhNjc=", "commit": {"author": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-09-02T09:06:54Z"}, "committer": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-09-02T09:06:54Z"}, "message": "fix(bug): prevent deletion/recreation of clusterroles\n\nThis PR fixes the bug where the cluster roles and clusterrolebindings were\ngetting deleted and recreated on every reconciliation from OpenEBS version\n2.0.0-ee-RC1 onwards.\n\nSigned-off-by: sagarkrsd <sagar.kumar@mayadata.io>", "tree": {"sha": "0fdf55164e05de3dde43ec54771093d242ce50c5", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/trees/0fdf55164e05de3dde43ec54771093d242ce50c5"}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/commits/5f583b4db3a23dd4aa09735eda00534a1a216a67", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/5f583b4db3a23dd4aa09735eda00534a1a216a67", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/5f583b4db3a23dd4aa09735eda00534a1a216a67", "comments_url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/5f583b4db3a23dd4aa09735eda00534a1a216a67/comments", "author": null, "committer": null, "parents": [{"sha": "74be4f841df7c10400a6760450d44c9bf61c87c2", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/74be4f841df7c10400a6760450d44c9bf61c87c2", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/74be4f841df7c10400a6760450d44c9bf61c87c2"}]}, {"sha": "7da72f64a80d139ee26f0c2880b0c2d147225000", "node_id": "MDY6Q29tbWl0MTkyMzYyNzA2OjdkYTcyZjY0YTgwZDEzOWVlMjZmMGMyODgwYjBjMmQxNDcyMjUwMDA=", "commit": {"author": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-08-24T07:39:02Z"}, "committer": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-08-24T07:39:50Z"}, "message": "enhance(install): remove nodeselector from Mayastor components\n\nSigned-off-by: sagarkrsd <sagar.kumar@mayadata.io>", "tree": {"sha": "24a651907ac57226a5dcafb0f928767fdadc1eec", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/trees/24a651907ac57226a5dcafb0f928767fdadc1eec"}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/commits/7da72f64a80d139ee26f0c2880b0c2d147225000", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/7da72f64a80d139ee26f0c2880b0c2d147225000", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/7da72f64a80d139ee26f0c2880b0c2d147225000", "comments_url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/7da72f64a80d139ee26f0c2880b0c2d147225000/comments", "author": null, "committer": null, "parents": [{"sha": "61441feb53a9446c281dc1a75e8ad1aefba497f7", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/61441feb53a9446c281dc1a75e8ad1aefba497f7", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/61441feb53a9446c281dc1a75e8ad1aefba497f7"}]}, {"sha": "c5afdce73df91ae2ebdb8720f7c25911e230faf7", "node_id": "MDY6Q29tbWl0MTkyMzYyNzA2OmM1YWZkY2U3M2RmOTFhZTJlYmRiODcyMGY3YzI1OTExZTIzMGZhZjc=", "commit": {"author": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-08-23T19:17:04Z"}, "committer": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-08-23T19:17:04Z"}, "message": "enhance(install): OpenEBS 2.0.0 and 2.0.0-ee install/upgrade support\n\nThis PR adds support for installation and upgrade of OpenEBS 2.0.0\nand 2.0.0-ee versions.\n\nIt adds the following support in addition to above:\n\n- CSI components are getting installed in openebs namespace instead of kube-system from OpenEBS version 2.0.0.\n- While upgrading from a lower OpenEBS version to 2.0.0/2.0.0-ee, CSI components will be installed in openebs\n  namespace and ones installed in kube-system will be deleted.\n- A new configmap for CSI ISCSIADM has been added which takes care of the OS based volumes and volume mounts.\n- A number of CSI related CRDs has been moved to v1 from v1alpha1.\n- Support for installation and upgrade of a number of new components such as NATS deployment, NATS service,\n  mayastorpool CRDs, etc has been added for Mayastor (v0.3.0).\n- It also handles the change in repository and container names of various Mayastor and CSI components.\n\nSigned-off-by: sagarkrsd <sagar.kumar@mayadata.io>", "tree": {"sha": "5f2bdedb9867f4b420a4fb0c2ef23cff7bd093d4", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/trees/5f2bdedb9867f4b420a4fb0c2ef23cff7bd093d4"}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/commits/c5afdce73df91ae2ebdb8720f7c25911e230faf7", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/c5afdce73df91ae2ebdb8720f7c25911e230faf7", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/c5afdce73df91ae2ebdb8720f7c25911e230faf7", "comments_url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/c5afdce73df91ae2ebdb8720f7c25911e230faf7/comments", "author": null, "committer": null, "parents": [{"sha": "9873829dbe21825bb78d9d49ec22bd9686f6126e", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/9873829dbe21825bb78d9d49ec22bd9686f6126e", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/9873829dbe21825bb78d9d49ec22bd9686f6126e"}]}]