[{"sha": "e6b2d4f8c4581ac0d39c2557c03bd1eb8d6bd82d", "node_id": "C_kwDOPbmbn9oAKGU2YjJkNGY4YzQ1ODFhYzBkMzljMjU1N2MwM2JkMWViOGQ2YmQ4MmQ", "commit": {"author": {"name": "Robert", "email": "robert.nguyenanh@gmail.com", "date": "2025-08-10T23:34:12Z"}, "committer": {"name": "Robert", "email": "robert.nguyenanh@gmail.com", "date": "2025-08-10T23:34:12Z"}, "message": "feat: Add Kubernetes deployment and service configurations for Mercato backend and frontend\n\n- Implemented backend deployment with environment variables sourced from secrets.\n- Created a service for the backend to expose port 3001.\n- Added Horizontal Pod Autoscaler for backend with CPU and memory utilization metrics.\n- Developed frontend deployment with environment variables and service exposing port 3000.\n- Configured Horizontal Pod Autoscaler for frontend.\n- Established Ingress resource for load balancing with TLS configuration.\n- Deployed Redis with persistent storage and monitoring service.\n- Configured Terraform scripts for EKS cluster setup, including IAM roles, VPC, subnets, and security groups.\n- Added user data script for EKS nodes to optimize performance and install monitoring tools.", "tree": {"sha": "8dcdcdbb0ef6a7de3e0d3efe6faa8fceacd58472", "url": "https://api.github.com/repos/robert-nguyenn/trading-platform-fullstack/git/trees/8dcdcdbb0ef6a7de3e0d3efe6faa8fceacd58472"}, "url": "https://api.github.com/repos/robert-nguyenn/trading-platform-fullstack/git/commits/e6b2d4f8c4581ac0d39c2557c03bd1eb8d6bd82d", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/robert-nguyenn/trading-platform-fullstack/commits/e6b2d4f8c4581ac0d39c2557c03bd1eb8d6bd82d", "html_url": "https://github.com/robert-nguyenn/trading-platform-fullstack/commit/e6b2d4f8c4581ac0d39c2557c03bd1eb8d6bd82d", "comments_url": "https://api.github.com/repos/robert-nguyenn/trading-platform-fullstack/commits/e6b2