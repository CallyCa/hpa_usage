s to be an external chart.\n\nThis adds back the `enabled` flag to the `nginx-ingress` chart in the `nginx` folder. Sets the default in `charts/nginx/values.yaml`, and `values.yaml` defaults to `true` to enable it.", "tree": {"sha": "8dc498ee8ca5d547c5cccf36e0e76e3740e6da86", "url": "https://api.github.com/repos/tidalf/charts-gitlab/git/trees/8dc498ee8ca5d547c5cccf36e0e76e3740e6da86"}, "url": "https://api.github.com/repos/tidalf/charts-gitlab/git/commits/09abd23406168bb2479ee2bb0f7bbcc32b284340", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/tidalf/charts-gitlab/commits/09abd23406168bb2479ee2bb0f7bbcc32b284340", "html_url": "https://github.com/tidalf/charts-gitlab/commit/09abd23406168bb2479ee2bb0f7bbcc32b284340", "comments_url": "https://api.github.com/repos/tidalf/charts-gitlab/commits/09abd23406168bb2479ee2bb0f7bbcc32b284340/comments", "author": {"login": "WarheadsSE", "id": 585036, "node_id": "MDQ6VXNlcjU4NTAzNg==", "avatar_url": "https://avatars.githubusercontent.com/u/585036?v=4", "gravatar_id": "", "url": "https://api.github.com/users/WarheadsSE", "html_url": "https://github.com/WarheadsSE", "followers_url": "https://api.github.com/users/WarheadsSE/followers", "following_url": "https://api.github.com/users/WarheadsSE/following{/other_user}", "gists_url": "https://api.github.com/users/WarheadsSE/gists{/gist_id}", "starred_url": "https://api.github.com/users/WarheadsSE/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/WarheadsSE/subscriptions", "organizations_url": "https://api.github.com/users/WarheadsSE/orgs", "repos_url": "https://api.github.com/users/WarheadsSE/repos", "events_url": "https://api.github.com/users/WarheadsSE/events{/privacy}", "received_events_url": "https://api.github.com/users/WarheadsSE/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login