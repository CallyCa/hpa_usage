[{"sha": "caed938d8fc78f40c822319aed5bb35eec9a048c", "node_id": "MDY6Q29tbWl0MjI0Mjc3NDM0OmNhZWQ5MzhkOGZjNzhmNDBjODIyMzE5YWVkNWJiMzVlZWM5YTA0OGM=", "commit": {"author": {"name": "DJ Mountney", "email": "david@twkie.net", "date": "2019-09-25T21:11:53Z"}, "committer": {"name": "DJ Mountney", "email": "david@twkie.net", "date": "2019-09-25T21:11:53Z"}, "message": "Switch to using newer APIs for ones dropped in k8s 1.16\n\nThese new APIs are supported in k8s 1.10+", "tree": {"sha": "bad742b11801a74fc21daa130f6d19ab0502078b", "url": "https://api.github.com/repos/tidalf/charts-gitlab/git/trees/bad742b11801a74fc21daa130f6d19ab0502078b"}, "url": "https://api.github.com/repos/tidalf/charts-gitlab/git/commits/caed938d8fc78f40c822319aed5bb35eec9a048c", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/tidalf/charts-gitlab/commits/caed938d8fc78f40c822319aed5bb35eec9a048c", "html_url": "https://github.com/tidalf/charts-gitlab/commit/caed938d8fc78f40c822319aed5bb35eec9a048c", "comments_url": "https://api.github.com/repos/tidalf/charts-gitlab/commits/caed938d8fc78f40c822319aed5bb35eec9a048c/comments", "author": {"login": "twk3", "id": 2806882, "node_id": "MDQ6VXNlcjI4MDY4ODI=", "avatar_url": "https://avatars.githubusercontent.com/u/2806882?v=4", "gravatar_id": "", "url": "https://api.github.com/users/twk3", "html_url": "https://github.com/twk3", "followers_url": "https://api.github.com/users/twk3/followers", "following_url": "https://api.github.com/users/twk3/following{/other_user}", "gists_url": "https://api.github.com/users/twk3/gists{/gist_id}", "starred_url": "https://api.github.com/users/twk3/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/twk3/subscriptions", "organizations_url": "https://api.github.com/users/twk3/orgs", "repos_url": "https://api.github.com/users/twk3/repos", "events_url": "https://api.github.com/users/twk3/events{/privacy}", "received_events_url": "https://api.github.com/users/twk3/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "twk3", "id": 2806882, "node_id": "MDQ6VXNlcjI4MDY4ODI=", "avatar_url": "https://avatars.githubusercontent.com/u/2806882?v=4", "gravatar_id": "", "url": "https://api.github.com/users/twk3", "html_url": "https://github.com/twk3", "followers_url": "https://api.github.com/users/twk3/followers", "following_url": "https://api.github.com/users/twk3/following{/other_user}", "gists_url": "https://api.github.com/users/twk3/gists{/gist_id}", "starred_url": "https://api.github.com/users/twk3/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/twk3/subscriptions", "organizations_url": "https://api.github.com/users/twk3/orgs", "repos_url": "https://api.github.com/users/twk3/repos", "events_url": "https://api.github.com/users/twk3/events{/privacy}", "received_events_url": "https://api.github.com/users/twk3/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "256b198e59cbd85815d012209c33e3a1745953e6", "url": "https://api.github.com/repos/tidalf/charts-gitlab/commits/256b198e59cbd85815d012209c33e3a1745953e6", "html_url": "https://github.com/tidalf/charts-gitlab/commit/256b198e59cbd85815d012209c33e3a1745953e6"}]}, {"sha": "28c2ad724bd5830448ce977d06b9ef60bb20a2c0", "node_id": "MDY6Q29tbWl0MjI0Mjc3NDM0OjI4YzJhZDcyNGJkNTgzMDQ0OGNlOTc3ZDA2YjllZjYwYmIyMGEyYzA=", "commit": {"author": {"name": "Jason Plum", "email": "jplum@gitlab.com", "date": "2018-11-16T21:13:25Z"}, "committer": {"name": "Jason Plum", "email": "jplum@gitlab.com", "date": "2018-11-19T17:15:23Z"}, "message": "nginx-ingress: sync to upstream 0.30.0\n\nSync our chart to the upstream 0.30.0\n\nUpstream has altered RBAC configuration:\n\n  RBAC is now enabled by default upstream. A single boolean enable\n  `rbac.create: true` now exists, and controls creation of the Role\n  and RoleBinding. Control of the ClusterRole creation based upon\n  `scope.enabled: false`. There is no longer the need for\n  `rbac.createClusterRole: false`. We set `scope.enabled: true`, so\n  the ClusterRole is still not made by default.\n\n  The serviceAccount is now controlled by `serviceAccount.create`\n  and `serviceAccount.name`. `serviceAccount.create` defaults to `true`\n\nUpstream has provided defaults for HPA via `controller.autoscaling`:\n\n  Upstream has now uncommented the defaults for `contoller.autoscaling`\n  to include integer values. It remains `enabled: false` at this time.\n\nRemove `semverCompare` calls against chart image tags\n\n  Address #910 and remove `semverCompare` calls against that container\n  image tags within this chart. This is a small change that can be rolled\n  in with the rest of this update.", "tree": {"sha": "d3fd9b096602ca8fbe2fb157e24773999b62611b", "url": "https://api.github.com/repos/tidalf/charts-gitlab/git/trees/d3fd9b096602ca8fbe2fb157e24773999b62611b"}, "url": "https://api.github.com/repos/tidalf/charts-gitlab/git/commits/28c2ad724bd5830448ce977d06b9ef60bb20a2c0", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/tidalf/charts-gitlab/commits/28c2ad724bd5830448ce977d06b9ef60bb20a2c0", "html_url": "https://github.com/tidalf/charts-gitlab/commit/28c2ad724bd5830448ce977d06b9ef60bb20a2c0", "comments_url": "https://api.github.com/repos/tidalf/charts-gitlab/commits/28c2ad724bd5830448ce977d06b9ef60bb20a2c0/comments", "author": {"login": "WarheadsSE", "id": 585036, "node_id": "MDQ6VXNlcjU4NTAzNg==", "avatar_url": "https://avatars.githubusercontent.com/u/585036?v=4", "gravatar_id": "", "url": "https://api.github.com/users/WarheadsSE", "html_url": "https://github.com/WarheadsSE", "followers_url": "https://api.github.com/users/WarheadsSE/followers", "following_url": "https://api.github.com/users/Warheads