[{"sha": "aca9136c8766ea13b44786376377a51d248018b2", "node_id": "C_kwDOPmeBO9oAKGFjYTkxMzZjODc2NmVhMTNiNDQ3ODYzNzYzNzdhNTFkMjQ4MDE4YjI", "commit": {"author": {"name": "phkaiser13", "email": "phgarcia2008@icloud.com", "date": "2025-09-05T17:33:35Z"}, "committer": {"name": "phkaiser13", "email": "phgarcia2008@icloud.com", "date": "2025-09-05T17:33:35Z"}, "message": "license: Relicense core project to AGPL-3.0\n\nThis change adopts the AGPL-3.0 license for the core Peitch components (CLI, modules, and operator) to better align with the project's goal of creating a foundational, community-driven DevOps platform.\n\nThe AGPL-3.0 specifically ensures that any modifications to network-accessible services like the `ph-operator` must be contributed back to the public domain. This protects the project's open-source nature from proprietary, closed-source forks offered as a service.\n\nThe `PeitchGUI` component remains under the permissive Apache-2.0 license to encourage a broad ecosystem of integrations.", "tree": {"sha": "256247433785c26e4d0f9d485f5ecb60992eb0cb", "url": "https://api.github.com/repos/phkaiser13/Peitch/git/trees/256247433785c26e4d0f9d485f5ecb60992eb0cb"}, "url": "https://api.github.com/repos/phkaiser13/Peitch/git/commits/aca9136c8766ea13b44786376377a51d248018b2", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/phkaiser13/Peitch/commits/aca9136c8766ea13b44786376377a51d248018b2", "html_url": "https://github.com/phkaiser13/Peitch/commit/aca9136c8766ea13b44786376377a51d248018b2", "comments_url": "https://api.github.com/repos/phkaiser13/Peitch/commits/aca9136c8766ea13b44786376377a51d248018b2/comments", "author": {"login": "phkaiser13", "id": 208978005, "node_id": "U_kgDODHTAVQ", "avatar_url": "https://avatars.githubusercontent.com/u/208978005?v=4", "gravatar_id": "", "url": "https://api.github.com/users/phkaiser13", "html_url": "https://gith