[{"sha": "565fa39dd2e68ade9be3fb71b3a22526abd2f2c4", "node_id": "C_kwDOPH6Sv9oAKDU2NWZhMzlkZDJlNjhhZGU5YmUzZmI3MWIzYTIyNTI2YWJkMmYyYzQ", "commit": {"author": {"name": "GenWatt", "email": "adrian.kosoglos@gmail.com", "date": "2025-07-26T19:30:40Z"}, "committer": {"name": "GenWatt", "email": "adrian.kosoglos@gmail.com", "date": "2025-07-26T19:30:40Z"}, "message": "Enhances Kubernetes deployment for scalability and observability\n\nAdds autoscaling, resource quotas, and pod disruption budgets for production workloads to improve resilience and scalability. Integrates service discovery and Prometheus/Grafana monitoring with improved annotations and dashboards. Installs NGINX ingress automatically in development, enables Grafana anonymous access, and standardizes resource limits and security best practices. Improves deployment robustness, observability, and operational automation for C# microservices.", "tree": {"sha": "9ca610b89afd55e63e552e397ebe1add0152c913", "url": "https://api.github.com/repos/GenWatt/GameAI/git/trees/9ca610b89afd55e63e552e397ebe1add0152c913"}, "url": "https://api.github.com/repos/GenWatt/GameAI/git/commits/565fa39dd2e68ade9be3fb71b3a22526abd2f2c4", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/GenWatt/GameAI/commits/565fa39dd2e68ade9be3fb71b3a22526abd2f2c4", "html_url": "https://github.com/GenWatt/GameAI/commit/565fa39dd2e68ade9be3fb71b3a22526abd2f2c4", "comments_url": "https://api.github.com/repos/GenWatt/GameAI/commits/565fa39dd2e68ade9be3fb71b3a22526abd2f2c4/comments", "author": {"login": "GenWatt", "id": 52327504, "node_id": "MDQ6VXNlcjUyMzI3NTA0", "avatar_url": "https://avatars.githubusercontent.com/u/52327504?v=4", "gravatar_id": "", "url": "https://api.github.com/users/GenWatt", "html_url": "https://github.com/GenWatt", "followers_url": "https://api.github.com/users/GenWatt/followers", "following_url": "https://api.g