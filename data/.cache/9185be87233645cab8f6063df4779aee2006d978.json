[{"sha": "fdd5e398163c80cd1a7c9be6601441d048850902", "node_id": "C_kwDOO_SCW9oAKGZkZDVlMzk4MTYzYzgwY2QxYTdjOWJlNjYwMTQ0MWQwNDg4NTA5MDI", "commit": {"author": {"name": "Jonathan Villanueva", "email": "jvillanueva@segurosmsc.com", "date": "2025-06-21T02:18:49Z"}, "committer": {"name": "Jonathan Villanueva", "email": "jvillanueva@segurosmsc.com", "date": "2025-06-21T02:18:49Z"}, "message": "Add initial setup for Python Flask application with Docker and Kubernetes\n\n- Created requirements.txt for Flask and dependencies.\n- Added supervisor configuration for process management.\n- Implemented Dockerfile for building the application image.\n- Created Docker Compose file for local development with MySQL and Adminer.\n- Developed main.py for a simple Flask application with health check and user retrieval endpoints.\n- Added Kubernetes deployment, service, and ingress configurations for the application.\n- Implemented Helm chart structure for easier deployment and management.\n- Configured Horizontal Pod Autoscaler for scaling based on CPU utilization.\n- Added support for TLS with cert-manager for secure ingress.\n- Updated README and notes for deployment requirements and instructions.", "tree": {"sha": "e063a1660fb840340f46a020444d3184e153945d", "url": "https://api.github.com/repos/jevillanueva/msc-k8s-course/git/trees/e063a1660fb840340f46a020444d3184e153945d"}, "url": "https://api.github.com/repos/jevillanueva/msc-k8s-course/git/commits/fdd5e398163c80cd1a7c9be6601441d048850902", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/jevillanueva/msc-k8s-course/commits/fdd5e398163c80cd1a7c9be6601441d048850902", "html_url": "https://github.com/jevillanueva/msc-k8s-course/commit/fdd5e398163c80cd1a7c9be6601441d048850902", "comments_url": "https://api.github.com/repos/jevillanueva/msc-k8s-course/commits/fdd5e398163c80cd1a7c9be6601441d048850902/comments", "aut