[{"sha": "cb96642e29938bef825b3c87d9be41ee6a1605e7", "node_id": "C_kwDOOoF61toAKGNiOTY2NDJlMjk5MzhiZWY4MjViM2M4N2Q5YmU0MWVlNmExNjA1ZTc", "commit": {"author": {"name": "Andrii Pavlenko", "email": "pavlenko@fastmail.com", "date": "2025-06-13T10:49:57Z"}, "committer": {"name": "Andrii Pavlenko", "email": "pavlenko@fastmail.com", "date": "2025-06-13T10:49:57Z"}, "message": "Implement Authelia wrapper chart following standardized pattern\n\n- Created complete wrapper chart structure with upstream dependency\n- Pre-install Helm hook job for automatic secret generation in Vault\n- External-secrets integration for Vault \u2192 Kubernetes secret sync\n- Proper RBAC and service account configuration\n- Comprehensive values configuration for homelab environment\n- Support for file-based authentication with users_database.yml\n- Redis session storage and OIDC provider configuration\n- Ingress with automatic TLS certificate management\n\nChart implements the documented wrapper pattern:\n1. Generates secrets in Vault if missing (idempotent)\n2. Syncs secrets from Vault to Kubernetes via external-secrets\n3. Configures upstream Authelia chart with generated secrets\n\nReady for deployment with sync wave ordering.", "tree": {"sha": "f955bf0ee3e610c9a29480bcec103df75ee9242a", "url": "https://api.github.com/repos/pavlenkoa/homelab/git/trees/f955bf0ee3e610c9a29480bcec103df75ee9242a"}, "url": "https://api.github.com/repos/pavlenkoa/homelab/git/commits/cb96642e29938bef825b3c87d9be41ee6a1605e7", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/pavlenkoa/homelab/commits/cb96642e29938bef825b3c87d9be41ee6a1605e7", "html_url": "https://github.com/pavlenkoa/homelab/commit/cb96642e29938bef825b3c87d9be41ee6a1605e7", "comments_url": "https://api.github.com/repos/pavlenkoa/homelab/commits/cb96642e29938bef825b3c87d9be41ee6a1605e7/comments", "author": {"login": "pavlenkoa", "