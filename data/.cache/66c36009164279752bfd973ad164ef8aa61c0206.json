[{"sha": "63b273feb57824f106a6d577cceb5e6964ae4a95", "node_id": "MDY6Q29tbWl0MTEzMDg4NDE0OjYzYjI3M2ZlYjU3ODI0ZjEwNmE2ZDU3N2NjZWI1ZTY5NjRhZTRhOTU=", "commit": {"author": {"name": "Chris Fordham", "email": "chris@fordham.id.au", "date": "2021-01-15T20:54:17Z"}, "committer": {"name": "GitHub", "email": "noreply@github.com", "date": "2021-01-15T20:54:17Z"}, "message": "Support for arm64, k8s, helm (#1552)\n\n* Initial helm chart, docker for arm64.\r\n\r\n* Add missing slash to local helm values file in gitignore.\r\n\r\n* Add in support to provide loadBalancerIP by helm value.\r\n\r\n* Ports should not be set on the service if using default ClusterIP svc type.\r\n\r\n* Revert svc condition.\r\n\r\n* Remove condition on service ports.\r\n\r\n* Add in nodePort key as a value configurable.\r\n\r\n* Provide a default nodePort value.\r\n\r\n* Make nodePort conditional.", "tree": {"sha": "406e85e9a76e4367804844b5bdf29c508ca44d6c", "url": "https://api.github.com/repos/CloudburstMC/Nukkit/git/trees/406e85e9a76e4367804844b5bdf29c508ca44d6c"}, "url": "https://api.github.com/repos/CloudburstMC/Nukkit/git/commits/63b273feb57824f106a6d577cceb5e6964ae4a95", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsBcBAABCAAQBQJgAgD5CRBK7hj4Ov3rIwAAdHIIAAj8ik5yxEVB9Gf9/1SBtexs\nuzxJXgqE5LxAYtxvq7lv9/IqWiwY8VV+1oz9spSWNmbF3z7P0PKJgsJY9zgDfFpG\nNRmdBBxQxsRemW1OWcA/XwVe00E1qmkQRoXc1uhUhU6rhp7vnlg4KFwHwKwV+xO6\nVfVmK/MLNOH4HgbSNtKSyfgrjpQanr3S9xrAz5gjDDEwbiBFSdWEL8utKq7uwBHq\nXONM4eMn1rv1nnphsNyp0IjNrlLCA4YKhZ+WwTLe+uU/B3w7CYi5cC4lbuKnCXco\nXRRT0dPkcoaDkbujI2o8IYgqBqrng+HDiLJ+eJpUayLA78JfDgEVthjaezBMlJg=\n=ZUxP\n-----END PGP SIGNATURE-----\n", "payload": "tree 406e85e9a76e4367804844b5bdf29c508ca44d6c\nparent 8343435e88b177396dce315298d470a0d3ea4770\nauthor Chris Fordham <chris@fordham.id.au> 1610744057 +1100\ncommitter GitHub <noreply@github.com> 1610744057 +0000\n\nSupport for arm64, k8s, helm (#1552)\n\n* Initial helm chart, docker for arm64.\r\n\r\n* Add missing slash to local helm values file in gitignore.\r\n\r\n* Add in support to provide loadBalancerIP by helm value.\r\n\r\n* Ports should not be set on the service if using default ClusterIP svc type.\r\n\r\n* Revert svc condition.\r\n\r\n* Remove condition on service ports.\r\n\r\n* Add in nodePort key as a value configurable.\r\n\r\n* Provide a default nodePort value.\r\n\r\n* Make nodePort conditional.", "verified_at": "2024-01-16T19:59:59Z"}}, "url": "https://api.github.com/repos/CloudburstMC/Nukkit/commits/63b273feb57824f106a6d577cceb5e6964ae4a95", "html_url": "https://github.com/CloudburstMC/Nukkit/commit/63b273feb57824f106a6d577cceb5e6964ae4a95", "comments_url": "https://api.github.com/repos/CloudburstMC/Nukkit/commits/63b273feb57824f106a6d577cceb5e6964ae4a95/comments", "author": {"login": "flaccid", "id": 131730, "node_id": "MDQ6VXNlcjEzMTczMA==", "avatar_url": "https://avatars.githubusercontent.com/u/131730?v=4", "gravatar_id": "", "url": "https://api.github.com/users/flaccid", "html_url": "https://github.com/flaccid", "followers_url": "https://api.github.com/users/flaccid/followers", "following_url": "https://api.github.com/users/flaccid/following{/other_user}", "gists_url": "https://api.github.com/users/flaccid/gists{/gist_id}", "starred_url": "https://api.github.com/users/flaccid/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/flaccid/subscriptions", "organizations_url": "https://api.github.com/users/flaccid/orgs", "repos_url": "https://api.github.com/users/flaccid/repos", "events_url": "https://api.github.com/users/flaccid/events{/privacy}", "received_events_url": "https://api.github.com/users/flaccid/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "web-flow", "id": 19864447, "node_id": "MDQ6VXNlcjE5ODY0NDQ3", "avatar_url": "https://avatars.githubusercontent.com/u/19864447?v=4", "gravatar_id": "", "url": "https://api.github.com/use