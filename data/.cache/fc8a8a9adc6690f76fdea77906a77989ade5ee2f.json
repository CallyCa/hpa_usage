[{"sha": "e9628766b68c2096363855dabe34d7d1ed53b646", "node_id": "C_kwDOPIVmINoAKGU5NjI4NzY2YjY4YzIwOTYzNjM4NTVkYWJlMzRkN2QxZWQ1M2I2NDY", "commit": {"author": {"name": "balejosg", "email": "ecomovequest@gmail.com", "date": "2025-08-02T16:23:13Z"}, "committer": {"name": "balejosg", "email": "ecomovequest@gmail.com", "date": "2025-08-02T16:23:13Z"}, "message": "fix: Complete deployment template for external service configurations\n\n- Add conditional logic in deployment template for database configuration\n- Support both mysql.auth and externalDatabase in environment variables\n- Support both redis.auth and externalRedis configurations\n- Support both rabbitmq.auth and externalRabbitmq configurations\n- Add missing password keys for external services in secret template\n- Resolve all nil pointer errors for production-grade deployment\n- Achieve 100% Helm chart validation success\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "tree": {"sha": "91ea8db2c7672882cb34bdeab8883cd180377eb8", "url": "https://api.github.com/repos/balejosg/guardianes-de-gaia/git/trees/91ea8db2c7672882cb34bdeab8883cd180377eb8"}, "url": "https://api.github.com/repos/balejosg/guardianes-de-gaia/git/commits/e9628766b68c2096363855dabe34d7d1ed53b646", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/balejosg/guardianes-de-gaia/commits/e9628766b68c2096363855dabe34d7d1ed53b646", "html_url": "https://github.com/balejosg/guardianes-de-gaia/commit/e9628766b68c2096363855dabe34d7d1ed53b646", "comments_url": "https://api.github.com/repos/balejosg/guardianes-de-gaia/commits/e9628766b68c2096363855dabe34d7d1ed53b646/comments", "author": {"login": "balejosg", "id": 89631734, "node_id": "MDQ6VXNlcjg5NjMxNzM0", "avatar_url": "https://avatars.githubusercontent.com/u/89631734?v=4", "gravatar_id": "", "url": "https://api.gi