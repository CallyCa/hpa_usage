[{"sha": "60ec546a808c18a3859f00aaadd8c273f8b79d17", "node_id": "C_kwDOOxAoh9oAKDYwZWM1NDZhODA4YzE4YTM4NTlmMDBhYWFkZDhjMjczZjhiNzlkMTc", "commit": {"author": {"name": "Offv", "email": "120146426+Offv@users.noreply.github.com", "date": "2025-07-31T21:20:09Z"}, "committer": {"name": "Offv", "email": "120146426+Offv@users.noreply.github.com", "date": "2025-07-31T21:20:09Z"}, "message": "Complete IoT Control System with Advanced Features\n\nMajor Features Added:\n- Dual heater control system (HTR-A & HTR-B) with shared temperature sensor\n- Advanced PID control with continuous auto mode section management\n- Individual timer settings per heater (5-120 seconds)\n- Comprehensive state persistence across page refreshes\n- MQTT stability improvements and centralized communication\n- Dynamic temperature-based heater section control (0\u21921\u21922\u21923 add, 3\u21922\u21921\u21920 remove)\n- Section 0 protection (never auto-removed)\n- Real-time PID output calculation and display\n- Collapsible debug logs and system status\n- Dark theme UI with improved operator experience\n- Temperature limits updated to 750\u00b0F maximum\n- Shared setpoint control across all heaters\n- Timer countdown display with circular progress indicator\n\nTechnical Improvements:\n- Removed hardcoded timer values, now fully dynamic\n- Fixed timer display synchronization issues\n- Enhanced error handling and logging\n- Optimized MQTT connection stability\n- Improved state management and persistence\n- Clean separation of concerns between components\n- Comprehensive debugging and monitoring tools\n\nUI/UX Enhancements:\n- Simplified dual control page as main interface\n- Hidden technical details from operators\n- Responsive design for different screen sizes\n- Clear visual indicators for system status\n- Intuitive controls with immediate feedback", "tree": {"sha": "5225fe5833177c5ba4074abc93eee204d3fa51d4", "url": "https://api.github.com/repos/Offv/iot-control-server/git/trees/5225fe5833177c5ba4074abc93eee204d3fa51d4"}, "url": "https://api.github.com/repos/Offv/iot-control-server/git/commits/60ec546a808c18a3859f00aaadd8c273f8b79d17", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/Offv/iot-control-server/commits/60ec546a808c18a3859f00aaadd8c273f8b79d17", "html_url": "https://github.com/Offv/iot-control-server/commit/60ec546a808c18a3859f00aaadd8c273f8b79d17", "comments_url": "https://api.github.com/repos/Offv/iot-control-server/commits/60ec546a808c18a3859f00aaadd8c273f8b79d17/comments", "author": {"login": "Offv", "id": 120146426, "node_id": "U_kgDOBylJ-g", "avatar_url": "https://avatars.githubusercontent.com/u/120146426?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Offv", "html_url": "https://github.com/Offv", "followers_url": "https://api.github.com/users/Offv/followers", "following_url": "https://api.github.com/users/Offv/following{/other_user}", "gists_url": "https://api.github.com/users/Offv/gists{/gist_id}", "starred_url": "https://api.github.com/users/Offv/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Offv/subscriptions", "organizations_url": "https://api.github.com/users/Offv/orgs", "repos_url": "https://api.github.com/users/Offv/repos", "events_url": "https://api.github.com/users/Offv/events{/privacy}", "received_events_url": "https://api.github.com/users/Offv/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "Offv", "id": 120146426, "node_id": "U_kgDOBylJ-g", "avatar_url": "https://avatars.githubusercontent.com/u/120146426?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Offv", "html_url": "https://github.com/Offv", "followers_url": "https://api.github.com/users/Offv/followers", "following_url": "https://api.github.com/users/Offv/following{/other_user}", "gists_url": "https://api.github.com/users/Offv/gists{/gist_i