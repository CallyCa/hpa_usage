[{"sha": "591229501377cbbefb65854b8b9d7d14b742778c", "node_id": "C_kwDOPk0679oAKDU5MTIyOTUwMTM3N2NiYmVmYjY1ODU0YjhiOWQ3ZDE0Yjc0Mjc3OGM", "commit": {"author": {"name": "mzet97", "email": "matheus.zeitune.developer@gmail.com", "date": "2025-08-27T02:06:02Z"}, "committer": {"name": "mzet97", "email": "matheus.zeitune.developer@gmail.com", "date": "2025-08-27T02:06:02Z"}, "message": "feat: add Kubernetes manifests for Redis, ArgoCD, monitoring, and dashboard services\n\nAdd comprehensive Kubernetes manifests for deploying various services including:\n- Redis cluster with config, secrets, services, and bootstrap job\n- ArgoCD with namespace, kustomization, ingress, and certificates\n- Monitoring stack with Prometheus, Grafana, node-exporter, and kube-state-metrics\n- Dashboard with RBAC, ingress, and certificates\n- MinIO console and S3 API services\n- Cert-manager issuers for local CA\n\nIncludes READMEs with deployment instructions for each service", "tree": {"sha": "b43f2d4809c9d1539d67d8312419eb4618afb8b7", "url": "https://api.github.com/repos/mzet97/k8s/git/trees/b43f2d4809c9d1539d67d8312419eb4618afb8b7"}, "url": "https://api.github.com/repos/mzet97/k8s/git/commits/591229501377cbbefb65854b8b9d7d14b742778c", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/mzet97/k8s/commits/591229501377cbbefb65854b8b9d7d14b742778c", "html_url": "https://github.com/mzet97/k8s/commit/591229501377cbbefb65854b8b9d7d14b742778c", "comments_url": "https://api.github.com/repos/mzet97/k8s/commits/591229501377cbbefb65854b8b9d7d14b742778c/comments", "author": {"login": "mzet97", "id": 103864403, "node_id": "U_kgDOBjDYUw", "avatar_url": "https://avatars.githubusercontent.com/u/103864403?v=4", "gravatar_id": "", "url": "https://api.github.com/users/mzet97", "html_url": "https://github.com/mzet97", "followers_url": "https://api.github.com/users/mzet97/followers", "following