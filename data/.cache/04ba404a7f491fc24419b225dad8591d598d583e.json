[{"sha": "4f6e3054a896fca17453d0cc3db4acfe33005bdf", "node_id": "C_kwDOPU3cXtoAKDRmNmUzMDU0YTg5NmZjYTE3NDUzZDBjYzNkYjRhY2ZlMzMwMDViZGY", "commit": {"author": {"name": "Daniel Schmidt", "email": "danschmidt88@gmail.com", "date": "2025-08-22T18:39:02Z"}, "committer": {"name": "Daniel Schmidt", "email": "danschmidt88@gmail.com", "date": "2025-08-22T18:39:02Z"}, "message": "feat(deployment): add global deployment framework for TPU protein diffusion\n\n- Introduce comprehensive global deployment module supporting multi-region\n  deployment, compliance frameworks, internationalization, and cross-platform\n  compatibility.\n- Support for region-specific configurations, compliance management,\n  localization, and failover handling.\n- Enable multi-language support with translations and cultural adaptations.\n- Implement compliance validation and data subject request handling.\n- Provide global deployment orchestration with load balancing and failover.\n- Add factory function for easy creation of global deployment manager.\n\nThis addition enables scalable and compliant global deployment of TPU-optimized\nprotein diffusion models.\n\nCo-authored-by: terragon-labs[bot] <terragon-labs[bot]@users.noreply.github.com>", "tree": {"sha": "d6066b624208969f2db68c5dadb247b9755100e7", "url": "https://api.github.com/repos/danieleschmidt/protein-diffusion-design-lab/git/trees/d6066b624208969f2db68c5dadb247b9755100e7"}, "url": "https://api.github.com/repos/danieleschmidt/protein-diffusion-design-lab/git/commits/4f6e3054a896fca17453d0cc3db4acfe33005bdf", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/danieleschmidt/protein-diffusion-design-lab/commits/4f6e3054a896fca17453d0cc3db4acfe33005bdf", "html_url": "https://github.com/danieleschmidt/protein-diffusion-design-lab/commit/4f6e3054a896fca17453d0cc3db4acfe33005bdf", "comments_url": "https://api.github.com/repos/da