[{"sha": "fae60ef02062355fec6694d5853fadafde99e8ef", "node_id": "C_kwDOPOmqjNoAKGZhZTYwZWYwMjA2MjM1NWZlYzY2OTRkNTg1M2ZhZGFmZGU5OWU4ZWY", "commit": {"author": {"name": "Rohan Vinaik", "email": "rohanpvinaik@gmail.com", "date": "2025-08-23T15:37:17Z"}, "committer": {"name": "Rohan Vinaik", "email": "rohanpvinaik@gmail.com", "date": "2025-08-23T15:37:17Z"}, "message": "fix: resolve import issues and circular dependencies\n\n- Renamed logging.py to logging_config.py to avoid conflict with Python's standard library\n- Fixed hypervector module imports to use hypervector_transform.encoding\n- Updated Settings class to ignore extra environment variables (Pydantic v2)\n- Fixed multiple syntax errors in gnark_backend.py\n- Resolved circular import between encoding.py file and encoding/ directory\n- All imports now working correctly across the genomevault package\n\nKey changes:\n- genomevault/logging.py \u2192 genomevault/logging_config.py\n- Updated hypervector/__init__.py to import from correct location\n- Settings.Config.extra = 'ignore' to handle environment variables\n- Removed duplicate encoding.py file in hypervector module\n- Fixed malformed docstrings and method structures in gnark_backend.py\n\nAll requested import checks passing:\n\u2713 All __init__.py files importable\n\u2713 HypervectorEncoder exports correctly\n\u2713 zk/real_engine.py imports verified\n\u2713 No circular import issues\n\u2713 Type hints working properly\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "tree": {"sha": "54fc5ce8cbff590891f7d1ee2e548a9035dcbe13", "url": "https://api.github.com/repos/rohanvinaik/GenomeVault/git/trees/54fc5ce8cbff590891f7d1ee2e548a9035dcbe13"}, "url": "https://api.github.com/repos/rohanvinaik/GenomeVault/git/commits/fae60ef02062355fec6694d5853fadafde99e8ef", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "