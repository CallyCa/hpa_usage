d46dd7725f6c6e3a72", "url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/commits/397d6973799e42620ae066d46dd7725f6c6e3a72", "html_url": "https://github.com/cheongfish/Airflow-On-Kind/commit/397d6973799e42620ae066d46dd7725f6c6e3a72"}]}, {"sha": "54656fade17d45e145572d5bf0a90055cf4dffde", "node_id": "C_kwDOK64sMdoAKDU0NjU2ZmFkZTE3ZDQ1ZTE0NTU3MmQ1YmYwYTkwMDU1Y2Y0ZGZmZGU", "commit": {"author": {"name": "Cheongwoon", "email": "rla10324@naver.com", "date": "2025-07-15T07:07:17Z"}, "committer": {"name": "Cheongwoon", "email": "rla10324@naver.com", "date": "2025-07-15T07:07:17Z"}, "message": "feat: Update Airflow deployment and PVC configurations\n\nThis commit introduces several updates to the Airflow deployment:\n\n- Modified `local-pvc.yaml` to specify `type: Directory` for local persistent volume claims.\n- Updated `manifest/airflow/override-values.yaml` to reflect changes in the Airflow image repository/tag and PVC claim names, aligning with the new storage setup.\n- Removed the old `manifest/airflow/local-pvc.yaml` as it's replaced by the updated `local-pvc.yaml` at the root.\n- Deleted all RPC server related YAML files under `manifest/airflow/templates/rpc-server/`, indicating a removal of RPC server components from the deployment.\n- Renamed `manifest/airflow/dag-pvc.yaml` to `nfs-pvc.yaml` to better reflect its purpose as an NFS-backed persistent volume claim for DAGs.\n\nThese changes streamline the Airflow deployment process and improve storage management.", "tree": {"sha": "af67939fa9c2a4fa514ba8b2825ee0f7a7b30d78", "url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/git/trees/af67939fa9c2a4fa514ba8b2825ee0f7a7b30d78"}, "url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/git/commits/54656fade17d45e145572d5bf0a90055cf4dffde", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/comm