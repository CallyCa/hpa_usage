[{"sha": "af54445dae3c6bf36f82fceb46ca6291216ed0b0", "node_id": "C_kwDOK64sMdoAKGFmNTQ0NDVkYWUzYzZiZjM2ZjgyZmNlYjQ2Y2E2MjkxMjE2ZWQwYjA", "commit": {"author": {"name": "cheongwoon", "email": "rla10324@naver.com", "date": "2025-07-16T13:49:00Z"}, "committer": {"name": "cheongwoon", "email": "rla10324@naver.com", "date": "2025-07-16T13:49:00Z"}, "message": "feat: Integrate Airflow deployment and refine Kind cluster setup\n\nThis commit introduces comprehensive changes to facilitate Airflow deployment on Kind, building upon the initial Kind cluster setup.\n\nKey changes include:\n- **Makefile**: Enhanced with new `deploy-airflow` and `clean-airflow` targets, and improved dynamic configuration generation for Kind.\n- **kind-cluster_template.yaml**: Updated to use dynamic paths for host and container mounts, improving flexibility.\n- **local-pv.yaml**: Added a new PersistentVolume definition specifically for Airflow DAGs.\n- **local-pvc.yaml**: Modified to align with the new `local-pv.yaml` for DAG persistence.\n- **manifest/airflow/override-values.yaml**: Adjusted Airflow image settings, disabled Redis persistence, and configured DAGs persistence.", "tree": {"sha": "8125b5006244c99886cd1ef7c82280969f4e3e9e", "url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/git/trees/8125b5006244c99886cd1ef7c82280969f4e3e9e"}, "url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/git/commits/af54445dae3c6bf36f82fceb46ca6291216ed0b0", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/commits/af54445dae3c6bf36f82fceb46ca6291216ed0b0", "html_url": "https://github.com/cheongfish/Airflow-On-Kind/commit/af54445dae3c6bf36f82fceb46ca6291216ed0b0", "comments_url": "https://api.github.com/repos/cheongfish/Airflow-On-Kind/commits/af54445dae3c6bf36f82fceb46ca6291216ed0b0/comments", "author": {"login": "cheongfish", "id": 102738