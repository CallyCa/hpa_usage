[{"sha": "0297e0da8ed3837e29f255d493ccfe0674fb688e", "node_id": "C_kwDOP9qJ1NoAKDAyOTdlMGRhOGVkMzgzN2UyOWYyNTVkNDkzY2NmZTA2NzRmYjY4OGU", "commit": {"author": {"name": "Marco Soto Maceda", "email": "158858927+marcosotomac@users.noreply.github.com", "date": "2025-10-07T06:50:36Z"}, "committer": {"name": "Marco Soto Maceda", "email": "158858927+marcosotomac@users.noreply.github.com", "date": "2025-10-07T06:50:36Z"}, "message": "feat: Add complete MLOps infrastructure\n\n- Model Registry: Version control and lifecycle management (dev \u2192 staging \u2192 prod)\n- Experiment Tracking: MLflow integration for all training runs\n- Model Monitoring: Prometheus metrics, drift detection, performance tracking\n- CI/CD Pipeline: GitHub Actions for automated testing and deployment\n- Docker: Dockerfile and docker-compose with full MLOps stack\n- Kubernetes: Deployment configs with HPA autoscaling\n- API Monitoring: Updated FastAPI with Prometheus metrics endpoints\n- Training Pipeline: MLOps-enabled training script with model registration\n- Deployment Script: Automated promotion and deployment workflow\n- Testing: Comprehensive tests for MLOps components\n- Documentation: Complete MLOps guide with examples\n- Makefile: Common tasks automation\n\nMLOps Stack includes:\n- API Server (FastAPI)\n- MLflow Tracking Server\n- Prometheus Monitoring\n- Grafana Dashboards", "tree": {"sha": "36e522c0a3ba44d01ca4e2c435812355ed8b74e1", "url": "https://api.github.com/repos/marcosotomac/ml-geometry/git/trees/36e522c0a3ba44d01ca4e2c435812355ed8b74e1"}, "url": "https://api.github.com/repos/marcosotomac/ml-geometry/git/commits/0297e0da8ed3837e29f255d493ccfe0674fb688e", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/marcosotomac/ml-geometry/commits/0297e0da8ed3837e29f255d493ccfe0674fb688e", "html_url": "https://github.com/marcosotomac/ml-geometry/commit/0297e0da8ed3837e29