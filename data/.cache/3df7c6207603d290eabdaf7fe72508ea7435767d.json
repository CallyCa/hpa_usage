[{"sha": "6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "node_id": "MDY6Q29tbWl0MTkyMzYyNzA2OjZlM2NhOGQxNmI2NmUwNTI2YmQ1N2Q1Y2Q5YjQ1NDM4YWEzMTRlZDE=", "commit": {"author": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-09-22T04:06:16Z"}, "committer": {"name": "sagarkrsd", "email": "sagar.kumar@mayadata.io", "date": "2020-09-22T04:06:23Z"}, "message": "fix(bug): fix upgrade issue after adoption\n\nThis PR fixes the following upgrade issue after adoption:\n1. Immutability error due to label selector\n2. Immutability error due to some envs such as OPENEBS_NAMESPACE.\n3. Issue due to container name difference in helm and operator way of installation.\n\nThis PR also adds:\n1. Update installer type from openebs-operator to openebs-enterprise-operator for google analytics.\n\nIt also does some refactoring wrt update logic of pod templates, label selector, etc.\n\nSigned-off-by: sagarkrsd <sagar.kumar@mayadata.io>", "tree": {"sha": "dfb00e8e85b1724a1f0b455b53d6a0eefc6cd1fb", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/trees/dfb00e8e85b1724a1f0b455b53d6a0eefc6cd1fb"}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/git/commits/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "html_url": "https://github.com/mayadata-io/openebs-upgrade/commit/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1", "comments_url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/6e3ca8d16b66e0526bd57d5cd9b45438aa314ed1/comments", "author": null, "committer": null, "parents": [{"sha": "cb94a6b32c42ea6a6440346751eab054b797a4cb", "url": "https://api.github.com/repos/mayadata-io/openebs-upgrade/commits/cb94a6b32c42ea6a6440346751eab054b797a4cb", "html_url": "https://github.com/mayadata-io/