[{"sha": "9742e973fea8bd8a03f97b5e7318576c36b95649", "node_id": "C_kwDOG43wStoAKDk3NDJlOTczZmVhOGJkOGEwM2Y5N2I1ZTczMTg1NzZjMzZiOTU2NDk", "commit": {"author": {"name": "ffppa", "email": "fabio.felici@pagopa.it", "date": "2025-05-08T13:47:37Z"}, "committer": {"name": "GitHub", "email": "noreply@github.com", "date": "2025-05-08T13:47:37Z"}, "message": "breaking: PAYMCLOUD-376 Fix uninstall step for Helm-managed scaled objects (#140)\n\n* Fix scaledobject helm managed for uninstall step\n\n* Add migration steps for v7.6 to migration guide\n\nDocument the necessary steps to label and annotate ScaledObjects for migrating to v7.6. Includes example commands and verification guidance to ensure correct application of changes.\n\n* Update migration guide for v7.7\n\nAdjust the migration guide header to reflect the correct version number. This change aligns the documentation with the updates introduced in v7.7.\n\n* Update migration guide for v7.7\n\nAdjust the migration guide header to reflect the correct version number. This change aligns the documentation with the updates introduced in v7.7.\n\n* Add missing newline in MIGRATION_GUIDE.md for readability\n\nThis change ensures consistent formatting in the guide by adding a newline before a code block. Improves readability and maintains proper structure in the documentation.\n\n* Reduce maxReplica to 1 in devopslab-dev values file\n\nThe maximum replicas for autoscaling have been reduced from 3 to 1. This change is likely aimed at optimizing resource usage or testing under limited scaling conditions.\n\n* Update migration guide and add KEDA v7 to v8 migration script\n\nThe migration guide now reflects steps for upgrading from v5.x/v7.x to v8.x. A new script is introduced to automate labeling and annotating KEDA ScaledObjects for proper Helm management during upgrades and deletions.\n\n* Add reference to migration script in guide\n\nUpdated the migration guide to include a reference to a script that facilitates migrating from v7 to v8. This addition helps users streamline the migration process and reduces potential errors.", "tree": {"sha": "f48967e75143f49c41db062d16269adbcd5852c8", "url": "https://api.github.com/repos/pagopa/aks-microservice-chart-blueprint/git/trees/f48967e75143f49c41db062d16269adbcd5852c8"}, "url": "https://api.github.com/repos/pagopa/aks-microservice-chart-blueprint/git/commits/9742e973fea8bd8a03f97b5e7318576c36b95649", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJoHLX5CRC1aQ7uu5UhlAAAVJwQAFFTDqNHNpmDu24NOm98Kv4D\nVL4msZKFDs5hGx9ZMd0wgjEArGef9emQSvKxbBTKIh2fTW1zwzyTP9acDesgNDSW\nBygvLYuu3UeTplbdtI5OBZYnAAQLZVXvbv1Wi87wNenJ3djR03lVBSlggJd0Nj9u\nWyzMSoRKYm1jTfv400ByUjKlawQvLYW7UNuYPCOCNYgGy42azCe7/zIdQMQrSKsS\nTA7pnokXDSRQephJZIc/Xn0KpZ2Yzqr67mfZ5jJZzzIH5VTl9G1O4E+C6n2K05mb\nUzSkPgYKk8wbnhvCYPfXLErmfxLAnIpHTd/qWRA6ggltxPp6aY1v9i9qoZKJ/UYR\nqO5xCzcaheb63Bi8Z5PsaNijxNL4ItIbdahEcgTiNsitord7ZHDCB4adpfQLeRiL\nRby9e3g5le7O9agvZNjcMLVIRzbjqyjQUS0rC5M21wJa8ODKE986+D8WBGj5ncXD\nI3sIFGvz6Hl1+yAsIUyiURvBEojpGkFSDDJSZkZXpiUJa5L3O36adP5xxY4+5RiO\n8+6VRkcWGfwT091OGAiFgnjpow4tIi8DWSu1dyiTLUJmko7aSkjrgvktMmKeVQhs\netqTIX07g2M38vUqkI0XjXgFef16bedDHc64TTaDFRNDTFlo+EEa8nHI78LVpL4t\nOW1S9db4KiikPGbmN2vV\n=kWA0\n-----END PGP SIGNATURE-----\n", "payload": "tree f48967e75143f49c41db062d16269adbcd5852c8\nparent 295b956960d6d7365f91c72a8576a693f0e201e7\nauthor ffppa <fabio.felici@pagopa.it> 1746712057 +0000\ncommitter GitHub <noreply@github.com> 1746712057 +0200\n\nbreaking: PAYMCLOUD-376 Fix uninstall step for Helm-managed scaled objects (#140)\n\n* Fix scaledobject helm managed for uninstall step\n\n* Add migration steps for v7.6 to migration guide\n\nDocument the necessary steps to label and annotate ScaledObjects for migrating to v7.6. Includes example commands and verification guidance to ensure correct application of changes.\n\n* Update migration guide for v7.7\n\nAdjust the migration guide header to reflect the correct version number. This change aligns the documentation with the updates introduced in v7.7.\n\n* Update migration guide for v7.7\n\nAdjust the migration guide header to reflect the correct version number. This change aligns the documentation with the updates introduced in v7.7.\n\n* Add missing newline in MIGRATION_GUIDE.md for readability\n\nThis change ensures consistent formatting in the guide by adding a newline before a code block. Improves readability and maintains proper structure in the documentation.\n\n* Reduce maxReplica to 1 in devopslab-dev values file\n\nThe maximum replicas for autoscaling have been reduced from 3 to 1. This change is likely aimed at optimizing resource usage or testing under limited scaling conditions.\n\n* Update migration guide and add KEDA v7 to v8 migration script\n\nThe migration guide now reflects steps for upgrading from v5.x/v7.x to v8.x. A new script is introduced to automate labeling and annotating KEDA ScaledObjects for proper Helm management during upgrades and deletions.\n\n* Add reference to migration script in guide\n\nUpdated the migration guide to include a reference to a script that facilitates migrating from v7 to v8. This addition helps users streamline the migration process and reduces potential errors.", "verified_at": "2025-05-08T13:47:40Z"}}, "url": "https://api.github.com/repos/pagopa/aks-microservice-chart-blueprint/commits/9742e973fea8bd8a03f97b5e7318576c36b95649", "html_url": "https://github.com/pagopa/aks-microservice-chart-blueprint/commit/9742e973fea8bd8a03f97b5e7318576c36b95649", "comments_url": "https://api.github.com/repos/pagopa/aks-microservice-chart-blueprint/commits/9742e973fea8bd8a03f97b5e7318576c36b95649/comments", "author": {"login": "ffppa", "id": 181717101, "node_id": "U_kgDOCtTIbQ", "avatar_url": "https://avatars.githubusercontent.com/u/181717101?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ffppa", "html_url": "https://github.com/ffppa", "followers_url