[{"sha": "1abd4851d87649dcb8351e2b79c3bfff366307e8", "node_id": "C_kwDOPVXnzdoAKDFhYmQ0ODUxZDg3NjQ5ZGNiODM1MWUyYjc5YzNiZmZmMzY2MzA3ZTg", "commit": {"author": {"name": "Alexandros Mandravillis", "email": "alexbeav@live.com", "date": "2025-08-12T10:07:22Z"}, "committer": {"name": "Alexandros Mandravillis", "email": "alexbeav@live.com", "date": "2025-08-12T10:07:22Z"}, "message": "feat: GitOps-driven GKE Config Connector platform with enterprise security\n\nComplete GitOps solution for managing GCP infrastructure as Kubernetes resources:\n\nFeatures:\n- GKE Autopilot cluster with Config Connector\n- Multi-environment infrastructure (dev/staging/prod)\n- Argo CD for continuous deployment\n- OPA Gatekeeper security policies\n- Workload Identity Federation\n- Customer-managed encryption (CMEK)\n- Private networking and VPC security\n- Security Command Center integration\n- Comprehensive monitoring and alerting\n\nInfrastructure Resources:\n- Pub/Sub topics and subscriptions\n- Cloud Storage buckets with CMEK\n- BigQuery datasets with encryption\n- Cloud SQL instances with private networking\n- IAM service accounts and policies\n- Organization policy constraints\n\nSecurity Features:\n- Enterprise-grade security policies\n- Data classification requirements\n- Private networking enforcement\n- Encryption key management\n- RBAC isolation across environments\n- Security posture monitoring\n\nGetting Started:\n1. Fork this repository\n2. Update configuration with your GCP project and GitHub details\n3. Run 'make setup-all' for complete deployment\n4. Access Argo CD UI with 'make argocd-ui'\n\nThis is a production-ready, open-source platform suitable for enterprise deployments.", "tree": {"sha": "0ac12051a4185916fe0d4736fc95678ba594f05d", "url": "https://api.github.com/repos/Alexbeav/gke-config-connector/git/trees/0ac12051a4185916fe0d4736fc95678ba594f05d"}, "url": "https://api.github.com/repos/Alexbeav/gke-config-connector/git/commits/1abd4851d87649dcb8351e2b79c3bfff366307e8", 