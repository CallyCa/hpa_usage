[{"sha": "4e65e464d69497f14388c5d40b49bf501f121fe3", "node_id": "C_kwDOPm_F9doAKDRlNjVlNDY0ZDY5NDk3ZjE0Mzg4YzVkNDBiNDliZjUwMWYxMjFmZTM", "commit": {"author": {"name": "Ricardo Neto", "email": "ron2302@gmail.com", "date": "2025-08-30T15:32:24Z"}, "committer": {"name": "Ricardo Neto", "email": "ron2302@gmail.com", "date": "2025-08-30T15:32:24Z"}, "message": "Initial commit: Complete FireDelivery Laravel application with React frontend\n\n\ud83d\ude80 Features:\n- Modular Laravel architecture with DDD structure\n- Multi-role authentication (Admin, Store, Deliverer)\n- Real-time delivery tracking with WebSocket integration\n- PIX payment system integration\n- Comprehensive API endpoints\n- React frontend with Inertia.js\n- Docker containerization with production configs\n- Kubernetes deployment manifests\n- Terraform infrastructure as code\n- Complete test suite\n- CI/CD GitHub Actions workflows\n- Monitoring and alerting setup\n\n\ud83d\udce6 Technology Stack:\n- Laravel 10.x with modular architecture\n- React 18 with modern hooks and context\n- PostgreSQL database\n- Redis for caching and queuing\n- Docker & Kubernetes\n- Terraform for AWS infrastructure\n- GitHub Actions for CI/CD\n\n\ud83d\udd27 Production Ready:\n- Comprehensive environment configurations\n- Security middleware and validation\n- Performance optimizations\n- Monitoring dashboards\n- Automated deployment pipelines", "tree": {"sha": "b4c3f254f4057cfe9a20b10e3580b7459d37e588", "url": "https://api.github.com/repos/ricardoon/firedelivery/git/trees/b4c3f254f4057cfe9a20b10e3580b7459d37e588"}, "url": "https://api.github.com/repos/ricardoon/firedelivery/git/commits/4e65e464d69497f14388c5d40b49bf501f121fe3", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/ricardoon/firedelivery/commits/4e65e464d69497f14388c5d40b49bf501f121fe3", "html_url": "https://github.com/ricardoon/firedelivery/com