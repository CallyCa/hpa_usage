lic", "site_admin": false}, "committer": {"login": "colinschoen", "id": 2927722, "node_id": "MDQ6VXNlcjI5Mjc3MjI=", "avatar_url": "https://avatars.githubusercontent.com/u/2927722?v=4", "gravatar_id": "", "url": "https://api.github.com/users/colinschoen", "html_url": "https://github.com/colinschoen", "followers_url": "https://api.github.com/users/colinschoen/followers", "following_url": "https://api.github.com/users/colinschoen/following{/other_user}", "gists_url": "https://api.github.com/users/colinschoen/gists{/gist_id}", "starred_url": "https://api.github.com/users/colinschoen/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/colinschoen/subscriptions", "organizations_url": "https://api.github.com/users/colinschoen/orgs", "repos_url": "https://api.github.com/users/colinschoen/repos", "events_url": "https://api.github.com/users/colinschoen/events{/privacy}", "received_events_url": "https://api.github.com/users/colinschoen/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "f00ebc06d9e547e84bad04d64a280e79f2fb817b", "url": "https://api.github.com/repos/okpy/ok/commits/f00ebc06d9e547e84bad04d64a280e79f2fb817b", "html_url": "https://github.com/okpy/ok/commit/f00ebc06d9e547e84bad04d64a280e79f2fb817b"}]}, {"sha": "8f888fe60076ddb06868e9cfd189056aa9b37cc7", "node_id": "MDY6Q29tbWl0MTk5OTI2OTE6OGY4ODhmZTYwMDc2ZGRiMDY4NjhlOWNmZDE4OTA1NmFhOWIzN2NjNw==", "commit": {"author": {"name": "Clemens Wolff", "email": "clemens@justamouse.com", "date": "2018-07-10T16:23:54Z"}, "committer": {"name": "Colin Schoen", "email": "cschoen@berkeley.edu", "date": "2018-07-10T16:23:54Z"}, "message": "Generate Sendgrid API key during Azure setup (#1311)\n\n* Increase minimum number of pods\r\n\r\nThis increases availability of the services.\r\n\r\n* Generate Sendgrid API key during Azure setup\r\n\r\nWe've been seeing some instability in production with the runtime\r\ncreation of API keys approach. This is because of race conditions where\r\none thread creates an API key and then at a later time another thread\r\nneeds to re-create the key (e.g. due to the worker or pod crashing and\r\nbeing restarted) thus invalidating the first one.\r\n\r\n* Fix formatting", "tree": {"sha": "dfc3dd5c976291e18bcdc63dfcd63b24284deb1c", "url": "https://api.github.com/repos/okpy/ok/git/trees/dfc3dd5c976291e18bcdc63dfcd63b24284deb1c"}, "url": "https://api.github.com/repos/okpy/ok/git/commits/8f888fe60076ddb06868e9cfd189056aa9b37cc7", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/okpy/ok/commits/8f888fe60076ddb06868e9cfd189056aa9b37cc7", "html_url": "https://github.com/okpy/ok/commit/8f888fe60076ddb06868e9cfd189056aa9b37cc7", "comments_url": "https://api.github.com/repos/okpy/ok/commits/8f888fe60076ddb06868e9cfd189056aa9b37cc7/comments", "author": {"login": "c-w", "id": 1086421, "node_id": "MDQ6VXNlcjEwODY0MjE=", "avatar_url": "https://avatars.githubusercontent.com/u/1086421?v=4", "gravatar_id": "", "url": "https://api.github.com/users/c-w", "html_url": "https://github.com/c-w", "followers_url": "https://api.github.com/users/c-w/followers", "following_url": "https://api.github.com/users/c-w/following{/other_user}", "gists_url": "https://api.github.com/users/c-w/gists{/gist_id}", "starred_url": "https://api.github.com/users/c-w/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/c-w/subscriptions", "organizations_url": "https://api.github.com/users/c-w/orgs", "repos_url": "https://api.github.com/users/c-w/repos", "events_url": "https://api.github.com/users/c-w/events{/privacy}", "received_events_url": "https://api.github.com/users/c-w/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "colinschoen", "id": 2927722, "node_id": "MDQ6VXNlcjI5Mjc3MjI=", "avatar_url": "https://avatars.githubusercontent.com/u/2927722?v=4", "gravatar_id": "", "url": "https://api.github.com/users/colinschoen", "html_url": "https://github.com/colinschoen", "followers_url": "https://api.github.com/users/colinschoen/followers", "following_url": "https://api.github.com/users/colinschoen/following{/other_user}", "gists_url": "https://api.github.com/users/colinschoen/gists{/gist_id}", "starred_url": "https://api.github.com/users/colinschoen/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/colinschoen/subscriptions", "organizations_url": "https://api.github.com/users/colinschoen/orgs", "repos_url": "https://api.github.com/users/colinschoen/repos", "events_url": "https://api.github.com/users/colinschoen/events{/privacy}", "received_events_url": "https://api.github.com/users/colinschoen/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "b5088885267c6f1448f118bd1e0bb508172b49bf", "url": "https://api.github.com/repos/okpy/ok/commits/b5088885267c6f1448f118bd1e0bb508172b49bf", "html_url": "https://github.com/okpy/ok/commit/b5088885267c6f1448f118bd1e0bb508172b49bf"}]}, {"sha": "e630eb7ebfa94b9fbb1c4dbb06bda338223a4115", "node_id": "MDY6Q29tbWl0MTk5OTI2OTE6ZTYzMGViN2ViZmE5NGI5ZmJiMWM0ZGJiMDZiZGEzMzgyMjNhNDExNQ==", "commit": {"author": {"name": "Clemens Wolff", "email": "clemens@justamouse.com", "date": "2018-07-06T17:01:16Z"}, "committer": {"name": "Sumukh Sridhara", "email": "sumukh1@gmail.com", "date": "2018-07-06T17:01:16Z"}, "message": "Switch Azure deployment to Kubernetes (#1301)\n\nPreviously we were hosting the ok-server, ok-worker, autopy-manager and\r\nautopy-worker in AppService for containers. However, we were seeing some\r\nissues with this approach as workers were killed without death\r\nnotifications and rq/Redis was getting confused. After this change, we\r\nnow deploy the compute (workers and servers) to Azure Kubernetes\r\nservice.\r\n\r\nIn order to make it easier to orchestrate the setup of the various\r\nresources in Azure as well as the Kubernetes deployments, we're using\r\nbash scripts. First, we create a bunch of resources using `setup.sh` and\r\nthen we configure them using `install.sh`. The setup scripts are wrapped\r\nin a Docker container so that the environment in which the scripts\r\nexecute is well known, e.g. Azure CLI is installed, helm is available,\r\nkubectl is available, etc.\r\n\r\nMost of the setup scripts fall-back to ARM templates to create the\r\nresources in Azure. The ARM templates can be modified to configure\r\nparameters such as resource SKUs, number of VMs to spin up for the\r\ncluster, type of VMs to use in the cluster, etc.\r\n\r\nThe install scripts perform operations such as creating the database\r\nschema, deploying the application to Kubernetes via Helm and setting up\r\nthe DNS for the Kubernetes ingress via the Azure CLI so that kube-lego\r\ncan configure a TLS certificate for the ingress via Let's Encrypt.\r\n\r\nNote that the ingress to the applications running in the Kubernetes\r\ncluster are configured as just one entrypoint so that a single TLS\r\ncertificate and DNS entry can be used (Azure public IP resource\r\ncurrently only support a single DNS label per IP). To solve routing, we\r\nthus need to mount the two sub-applications (OKpy and AutoPY) at\r\nsub-urls of the ingress which requires some minor application changes\r\nwhich are submitted in a separate pull request:\r\nhttps://github.com/okpy/ok/pull/1300\r\n\r\nThe setup scripts can be run either via the \"Deploy to Azure\" button (in\r\nwhich case the setup Docker container is run in an Azure Container\r\nInstance) or via a local `docker run` command. In the latter case, it's\r\nadvised to also include a volume mount `docker run -v $PWD:/app/secrets`\r\nso that the access keys for the resources created during the deployment\r\nwill be made available to the deployer. Note that in order to skip\r\ndeploying specific resources (e.g. to re-use existing resources), you\r\ncan place a file into the secrets folder that contains the access keys\r\nfor your existing resources in which case the setup scripts will skip\r\ndeploying that step.", "tree": {"sha": "7a033f4e300f6d69811bc96c45a596056f242f88", "url": "https://api.github.com/repos/okpy/ok/git/trees/7a033f4e300f6d69811bc96c45a596056f242f88"}, "url": "https://api.github.com/repos/okpy/ok/git/commits/e630eb7ebfa94b9fbb1c4dbb06bda338223a4115", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/okpy/ok/commits/e630eb7ebfa94b9fbb1c4dbb06bda338223a4115", "html_url": "https://github.com/okpy/ok/commit/e630eb7ebfa94b9fbb1c4dbb06bda338223a4115", "comments_url": "https://api.github.com/repos/okpy/ok/commits/e630eb7ebfa94b9fbb1c4dbb06bda338223a4115/comments", "author": {"login": "c-w", "id": 1086421, "node_id": "MDQ6VXNlcjEwODY0MjE=", "avatar_url": "https://avatars.githubusercontent.com/u/1086421?v=4", "gravatar_id": "", "url": "https://api.github.com/users/c-w", "html_url": "https://github.com/c-w", "followers_url": "https://api.github.com/users/c-w/followers", "following_url": "https://api.github.com/users/c-w/following{/other_user}", "gists_url": "https://api.github.com/users/c-w/gists{/gist_id}", "starred_url": "https://api.github.com/users/c-w/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/c-w/subscriptions", "organizations_url": "https://api.github.com/users/c-w/orgs", "repos_url": "https://api.github.com/users/c-w/repos", "events_url": "https://api.github.com/users/c-w/events{/privacy}", "received_events_url": "https://api.github.com/users/c-w/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "Sumukh", "id": 882381, "node_id": "MDQ6VXNlcjg4MjM4MQ==", "avatar_url": "https://avatars.githubusercontent.com/u/882381?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Sumukh", "html_url": "https://github.com/Sumukh", "followers_url": "https://api.github.com/users/Sumukh/followers", "following_url": "https://api.github.com/users/Sumukh/following{/other_user}", "gists_url": "https://api.github.com/users/Sumukh/gists{/gist_id}", "starred_url": "https://api.github.com/users/Sumukh/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Sumukh/subscriptions", "organizations_url": "https://api.github.com/users/Sumukh/orgs", "repos_url": "https://api.github.com/users/Sumukh/repos", "events_url": "https://api.github.com/users/Sumukh/events{/privacy}", "received_events_url": "https://api.github.com/users/Sumukh/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "ba8cc22883101d8eac159171ef64a4c8b01a7a00", "url": "https://api.github.com/repos/okpy/ok/commits/ba8cc22883101d8eac159171ef64a4c8b01a7a00", "html_url": "https://github.com/okpy/ok/commit/ba8cc22883101d8eac159171ef64a4c8b01a7a00"}]}]