abassgonzalez/repos", "events_url": "https://api.github.com/users/seabassgonzalez/events{/privacy}", "received_events_url": "https://api.github.com/users/seabassgonzalez/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "a5288658463f02b8105e88b852ebcb6f54de14db", "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/commits/a5288658463f02b8105e88b852ebcb6f54de14db", "html_url": "https://github.com/T-W-M-B-W-C/BetterPrompts/commit/a5288658463f02b8105e88b852ebcb6f54de14db"}]}, {"sha": "110ffbab10bc96b4f83be8741f9119914b6b7cec", "node_id": "C_kwDOPP2lztoAKDExMGZmYmFiMTBiYzk2YjRmODNiZTg3NDFmOTExOTkxNGI2YjdjZWM", "commit": {"author": {"name": "LeChristopher Blackwell", "email": "codeblackwell@gmail.com", "date": "2025-08-23T10:37:01Z"}, "committer": {"name": "LeChristopher Blackwell", "email": "codeblackwell@gmail.com", "date": "2025-08-23T10:37:01Z"}, "message": "refactor: clean up infrastructure and simplify model deployment\n\n- Remove unused Kubernetes configurations (all k8s yaml files)\n- Remove duplicate gateway configs (Kong, Traefik, duplicate nginx)\n- Remove unused monitoring configurations\n- Delete broken deploy.sh script (referenced deleted k8s infrastructure)\n- Delete unused mock/dev helper scripts (create_mock_model.py, create_fast_handler.py)\n- Simplify GitHub workflow to only build Docker images (removed k8s deployment)\n- Switch from AWS ECR to GitHub Container Registry for simpler setup\n- Keep only essential TorchServe components for model serving\n\nThis removes ~60+ unused infrastructure files while preserving core model serving capability.", "tree": {"sha": "0a8908aea298e3f33c4b413fd475530c26bbf550", "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/git/trees/0a8908aea298e3f33c4b413fd475530c26bbf550"}, "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/git/commits/110ffbab10bc96b4f83be8741f9119914b6b7cec", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/commits/110ffbab10bc96b4f83be8741f9119914b6b7cec", "html_url": "https://github.com/T-W-M-B-W-C/BetterPrompts/commit/110ffbab10bc96b4f83be8741f9119914b6b7cec", "comments_url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/commits/110ffbab10bc96b4f83be8741f9119914b6b7cec/comments", "author": {"login": "CodeBlackwell", "id": 16550398, "node_id": "MDQ6VXNlcjE2NTUwMzk4", "avatar_url": "https://avatars.githubusercontent.com/u/16550398?v=4", "gravatar_id": "", "url": "https://api.github.com/users/CodeBlackwell", "html_url": "https://github.com/CodeBlackwell", "followers_url": "https://api.github.com/users/CodeBlackwell/followers", "following_url": "https://api.github.com/users/CodeBlackwell/following{/other_user}", "gists_url": "https://api.github.com/users/CodeBlackwell/gists{/gist_id}", "starred_url": "https://api.github.com/users/CodeBlackwell/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/CodeBlackwell/subscriptions", "organizations_url": "https://api.github.com/users/CodeBlackwell/orgs", "repos_url": "https://api.github.com/users/CodeBlackwell/repos", "events_url": "https://api.github.com/users/CodeBlackwell/events{/privacy}", "received_events_url": "https://api.github.com/users/CodeBlackwell/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "CodeBlackwell", "id": 16550398, "node_id": "MDQ6VXNlcjE2NTUwMzk4", "avatar_url": "https://avatars.githubusercontent.com/u/16550398?v=4", "gravatar_id": "", "url": "https://api.github.com/users/CodeBlackwell", "html_url": "https://github.com/CodeBlackwell", "followers_url": "https://api.github.com/users/CodeBlackwell/followers", "following_url": "https://api.github.com/users/CodeBlackwell/following{/other_user}", "gists_url": "https://api.github.com/users/CodeBlackwell/gists{/gist_id}", "starred_url": "https://api.github.com/users/CodeBlackwell/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/CodeBlackwell/subscriptions", "organizations_url": "https://api.github.com/users/CodeBlackwell/orgs", "repos_url": "https://api.github.com/users/CodeBlackwell/repos", "events_url": "https://api.github.com/users/CodeBlackwell/events{/privacy}", "received_events_url": "https://api.github.com/users/CodeBlackwell/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "parents": [{"sha": "8d180747906eacc5ea795bcd56df0199faba5c65", "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/commits/8d180747906eacc5ea795bcd56df0199faba5c65", "html_url": "https://github.com/T-W-M-B-W-C/BetterPrompts/commit/8d180747906eacc5ea795bcd56df0199faba5c65"}]}, {"sha": "e1d847fc927cc075cd7b7717f256f4e1e072d206", "node_id": "C_kwDOPP2lztoAKGUxZDg0N2ZjOTI3Y2MwNzVjZDdiNzcxN2YyNTZmNGUxZTA3MmQyMDY", "commit": {"author": {"name": "LeChristopher Jon Blackwell", "email": "CodeBlackwell@gmail.com", "date": "2025-07-18T17:16:58Z"}, "committer": {"name": "LeChristopher Jon Blackwell", "email": "CodeBlackwell@gmail.com", "date": "2025-07-18T17:16:58Z"}, "message": "feat: add TorchServe model serving infrastructure\n\nComplete production-ready model serving setup:\n\nCore Components:\n- Custom TorchServe handler for DeBERTa-v3 intent classifier\n- Full inference pipeline with pre/post processing\n- Technique recommendation based on intent classification\n- Complexity scoring and confidence calibration\n\nInfrastructure:\n- Docker configuration with GPU support\n- Kubernetes manifests with auto-scaling (HPA)\n- Multi-environment support (dev/staging/prod)\n- Service mesh ready configuration\n\nDeployment Automation:\n- Automated deployment script with multiple strategies\n- Rolling, canary, and blue-green deployment support\n- Smoke testing and automated rollback\n- Model versioning and registry integration\n\nMonitoring & Observability:\n- Prometheus metrics collection\n- Grafana dashboards for model performance\n- Custom alerts for SLA monitoring\n- Request tracing and logging\n\nAPI Gateway Integration:\n- Nginx configuration for load balancing\n- Kong and Traefik alternatives\n- Rate limiting and caching\n- SSL/TLS termination\n\nProduction Features:\n- GPU optimization with mixed precision\n- Batch inference support\n- Model warmup procedures\n- Graceful shutdown handling\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "tree": {"sha": "666877e3bf98c39b3726084038e81c6282333f7e", "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/git/trees/666877e3bf98c39b3726084038e81c6282333f7e"}, "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/git/commits/e1d847fc927cc075cd7b7717f256f4e1e072d206", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/commits/e1d847fc927cc075cd7b7717f256f4e1e072d206", "html_url": "https://github.com/T-W-M-B-W-C/BetterPrompts/commit/e1d847fc927cc075cd7b7717f256f4e1e072d206", "comments_url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/commits/e1d847fc927cc075cd7b7717f256f4e1e072d206/comments", "author": {"login": "CodeBlackwell", "id": 16550398, "node_id": "MDQ6VXNlcjE2NTUwMzk4", "avatar_url": "https://avatars.githubusercontent.com/u/16550398?v=4", "gravatar_id": "", "url": "https://api.github.com/users/CodeBlackwell", "html_url": "https://github.com/CodeBlackwell", "followers_url": "https://api.github.com/users/CodeBlackwell/followers", "following_url": "https://api.github.com/users/CodeBlackwell/following{/other_user}", "gists_url": "https://api.github.com/users/CodeBlackwell/gists{/gist_id}", "starred_url": "https://api.github.com/users/CodeBlackwell/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/CodeBlackwell/subscriptions", "organizations_url": "https://api.git