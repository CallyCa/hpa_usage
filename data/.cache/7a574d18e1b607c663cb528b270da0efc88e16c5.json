[{"sha": "1ff2b8fc6ea3962f5a6deee4bc30be3f9d17a426", "node_id": "C_kwDOPP2lztoAKDFmZjJiOGZjNmVhMzk2MmY1YTZkZWVlNGJjMzBiZTNmOWQxN2E0MjY", "commit": {"author": {"name": "Sebastia\u0301n Alejandro Gonza\u0301lez", "email": "seabassgonzalez@gmail.com", "date": "2025-08-29T02:56:04Z"}, "committer": {"name": "Sebastia\u0301n Alejandro Gonza\u0301lez", "email": "seabassgonzalez@gmail.com", "date": "2025-08-29T02:56:04Z"}, "message": "feat: Clean start with functional BetterPrompts stack\n\n- Fixed Docker build issues for ARM64/Apple Silicon compatibility\n- Updated PyTorch requirements to use standard version instead of +cpu\n- Added docker-compose.local.yml for simplified local development\n- Created comprehensive API test examples in test-api-examples.sh\n- Updated CLAUDE.md with clear service architecture and startup instructions\n- Fixed technique-selector Dockerfile cross-compilation issue\n- All core services now running and healthy\n- Added service flow documentation and quick start guide\n\nServices running:\n- API Gateway (8000)\n- Intent Classifier (8001)\n- Technique Selector (8002)\n- Prompt Generator (8003)\n- PostgreSQL (5432)\n- Redis (6379)\n- TorchServe (8080)\n- Nginx (80)\n- Prometheus (9090)\n- Grafana (3001)\n\n\ud83e\udd16 Generated with Claude Code\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "tree": {"sha": "089f719acf1adcfe9c1748e0ffcc231a83a45e20", "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/git/trees/089f719acf1adcfe9c1748e0ffcc231a83a45e20"}, "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/git/commits/1ff2b8fc6ea3962f5a6deee4bc30be3f9d17a426", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/T-W-M-B-W-C/BetterPrompts/commits/1ff2b8fc6ea3962f5a6deee4bc30be3f9d17a426", "html_url": "https://github.com/T-W-M-B-W-C/BetterPrompts/commit/1ff2b8fc6ea3962f5a6deee4bc30be3f9d17a426", "comments