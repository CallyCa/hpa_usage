[{"sha": "372f4a8676b134b966d4b27a0f69d07db9471083", "node_id": "C_kwDOC6yQYtoAKDM3MmY0YTg2NzZiMTM0Yjk2NmQ0YjI3YTBmNjlkMDdkYjk0NzEwODM", "commit": {"author": {"name": "Brice Figureau", "email": "brice.figureau@datadoghq.com", "date": "2025-02-24T09:06:57Z"}, "committer": {"name": "GitHub", "email": "noreply@github.com", "date": "2025-02-24T09:06:57Z"}, "message": "Add TLS configuration to Recommender http client (#252)\n\n* Add TLS configuration to Recommender http client\r\n\r\nThis allows to set client certificate along with server CA allowing\r\nthe recommender server to implement mTLS and validate client certificate.\r\nNote that this will work only with a default client implementing an\r\nhttp.Transport. Any other RoundTripper will need to implement their\r\nown TLS implementation.\r\nThe implementation here reloads the certificate and private key for\r\nevery request to a given recommender endpoint. This is to support\r\nsystems where certificate can be rotated from time to time.\r\n\r\n* Implement certificate caching\r\n\r\nTo prevent reloading the certificate and key from disk at every new\r\nHTTPs connection we cache the certificate in a central cache (up until\r\nit is either expired or too old). The cache is trimmed every 10 minutes\r\nto remove stale entries (not accessed after 10 min).\r\n\r\n* Supports setting wpa default TLS config for the recommender API\r\n\r\nFor environment where certificates can be the same for all WPA resources,\r\nit might be cumbersome to specify the same client certificate in all\r\nthe recommender specs.\r\nBy using the `--tls-*` option it is possible to set default CA, certificate\r\nand key files (along with a few other TLS options) that will be used\r\nwhen the recommender specs don't contain such information.\r\n\r\n* Retry if certificate & key loaded don't match\r\n\r\nFor environments where client certificate loaded from disks are renewed\r\nit is very possible that the certificate generator can't write both files\r\natomically. More care should be used when reading so that if the certificate\r\nand the key don't match, reading is retried until there's either a match or\r\na failure.\r\n\r\n* Declare the recommender tls_config in the CRD\r\n\r\n* Refactor tests for a bit more readability\r\n\r\n* Review fixes\r\n\r\n* Remove LRU mentions as the cache is not an LRU cache\r\n* Cache errors for 1 min to prevent busy looping reading invalid certs\r\n\r\n* Review fix: reorder TLS functions\r\n\r\nSo that types and methods are close together.\r\n\r\n* Regenerate all bundle and manifests", "tree": {"sha": "d7f42e26f6ff62519e7b7871715544394da4d3ca", "url": "https://api.github.com/repos/DataDog/watermarkpodautoscaler/git/trees/d7f42e26f6ff62519e7b7871715544394da4d3ca"}, "url": "https://api.github.com/repos/DataDog/watermarkpodautoscaler/git/commits/372f4a8676b134b966d4b27a0f69d07db9471083", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJnvDaxCRC1aQ7uu5UhlAAAnKMQACwHjzyMdZBP3bfoTXNsYyGU\nyYq53xlD8NQjjpx/y3cqGKJxPVqDGOE5jDVSNKFwi/BXr42b9fD6xEAA5a6kB/ca\nwRg4pWOR9Zdi5GcqACbReAUO/qADuyh1UtdPjOO82CvDhdXYHGpqmN+ebRsbWoM6\nO6HJBCVVsVAhXBkLBJnCcIIFMyCQvfn7d3HBoveFOJz1pfkHbpEumQasYbbOCUa1\nLNPy3M/VHnF/mfmq04WI1EwWOpQ/PyLRaeQFkZnDLSBxAYZR32tj6oXCoPF6tDiV\nc9+QDbIUwKhEPvpHh4quLfym9bOgFsfJoGa9vxNPKAsqFKzfWpiz7sPN2U5Yg2/n\n404Vv2Uqb6lRU222HQvVnXDa4qEPhW0wkcAH7VTE2hi+s/KiySQYxjASUJTS9mHP\nmEBGBMLedlKRm5YLfMkJfMlrLUO05g+8X4QXDA0XxfRLAlfkvUEwrzmlypZzld8i\nAyUySK2e81qUvTC+qtIewvDNbCKTZ7NmdjVbuGG2s10KWRlcmIjK3gaUvAGyhRt0\n8Vu7s8+FzAMZfdJNKWr/Jb3Zalmv4yFTJ7MFoCOgwPZa+t7dA9TGSrvZZqAO5l1P\nUEajc7GiPfNWG9Viu8IV81rD5X0a+WLzlnhcW9orYeuVO1GVXrf/Q+CdQy+mTdEL\n3XwT+7x7NJUs8khzRJLZ\n=uRVA\n-----END PGP SIGNATURE-----\n", "payload": "tree d7f42e26f6ff62519e7b7871715544394da4d3ca\nparent 8b765f58f835801b5b9bd1abffcd96cbc4048af8\nauthor Brice Figureau <brice.figureau@datadoghq.com> 1740388017 +0100\ncommitter GitHub <noreply@github.com> 1740388017 +0100\n\nAdd TLS configuration to Recommender http client (#252)\n\n* Add TLS configuration to Recommender http client\r\n\r\nThis allows to set client certificate along with server CA allowing\r\nthe recommender server to implement mTLS and validate client certificate.\r\nNote that this will work only with a default client implementing an\r\nhttp.Transport. Any other RoundTripper will need to implement their\r\nown TLS implementation.\r\nThe implementation here reloads the certificate and private key for\r\nevery request to a given recommender endpoint. This is to support\r\nsystems where certificate can be rotated from time to time.\r\n\r\n* Implement certificate caching\r\n\r\nTo prevent reloading the certificate and key from disk at every new\r\nHTTPs connection we cache the certificate in a central cache (up until\r\nit is either expired or too old). The cache is trimmed every 10 minutes\r\nto remove stale entries (not accessed after 10 min).\r\n\r\n* Supports setting wpa default TLS config for the recommender API\r\n\r\nFor environment where certificates can be the same for all WPA resources,\r\nit might be cumbersome to specify the same client certificate in all\r\nthe recommender specs.\r\nBy using the `--tls-*` option it is possible to set default CA, certificate\r\nand key files (along with a few other TLS options) that will be used\r\nwhen the recommender specs don't contain such information.\r\n\r\n* Retry if certificate & key loaded don't match\r\n\r\nFor environments where client certificate loaded from disks are renewed\r\nit is very possible that the certificate generator can't write both files\r\natomically. More care should be used when reading so that if the certificate\r\nand the key don't match, reading is retried until there's either a match or\r\na failure.\r\n\r\n* Declare the recommender tls_config in the CRD\r\n\r\n* Refactor tests for a bit more readability\r\n\r\n* Review fixes\r\n\r\n* Remove LRU mentions as the cache is not an LRU cache\r\n* Cache errors for 1 min to prevent busy looping reading invalid certs\r\n\r\n* Review fix: reorder TLS functions\r\n\r\nSo that types and methods are close together.\r\n\r\n* Regenerate all bundle and manifests", "verified_at": "2025-02-24T09:06:59Z"}}, "url": "https://api.github.com/repos/DataDog/watermarkpodautoscaler/commits/372f4a8676b134b966d4b27a0f69d07db9471083", "html_url": "https://github.com/DataDog/watermarkpodautoscaler/commit/372f4a8676b134b966d4b27a0f69d07db9471083", "comments_url": "https://api.github.com/repos/DataDog/watermarkpodautoscaler/commits/372f4a8676b134b966d4b27a0f69d07db9471083/comments", "author": {"login": "masterzen", "id": 20242, "node_id": "MDQ6VXNlcjIwMjQy", "avatar_url": "https://avatars.githubusercontent.com/u/20242?v=4", "gravatar_id": "", "url": "https://api.github.com/users/masterzen", "html_url": "https://github.com/masterzen", "followers_url": "https://api.github.com/users/masterzen/followers", "following_url": "https://api.github.com/users/masterzen/following{/other_user}", "gists_url": "https://api.github.com/users/masterzen/gists{/gist_id}", "starred_url": "https://api.github.com/users/masterzen/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/masterzen/subscriptions", "organizations_url": "https://api.github.com/users/masterzen/orgs", "repos_url": "https://api.github.com/users/masterzen/repos", "events_url": "https://api.github.com/users/masterzen/events{/privacy}", "received_events_url": "https://api.github.com/users/masterzen/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "committer": {"login": "web-flow", "id": 19864447, "node_id": "MDQ6VXNlcjE5ODY0NDQ3", "avatar_url": "https://avatars.githubusercontent.com/u/19864447?v=4", "gravatar_id": "", "url": "https://api.github.com/users/web-flow", "html_url": "https://github.com/web-flow", "followers_url": "https://api.github.com/users/web-flow/followers", "following_url": "https://api.github.