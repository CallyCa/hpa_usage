[{"sha": "a31eee021272140bec82d492c2fb94b9d2550e58", "node_id": "C_kwDOOqiyyNoAKGEzMWVlZTAyMTI3MjE0MGJlYzgyZDQ5MmMyZmI5NGI5ZDI1NTBlNTg", "commit": {"author": {"name": "DimaJoyti", "email": "aws.inspiration@gmail.com", "date": "2025-07-25T23:29:56Z"}, "committer": {"name": "DimaJoyti", "email": "aws.inspiration@gmail.com", "date": "2025-07-25T23:29:56Z"}, "message": "feat: add UI components for progress, scroll area, separator, table, tabs, toast, and trading card\n\n- Implemented Progress component using Radix UI for visual progress indication.\n- Created ScrollArea component for scrollable content with custom scrollbar.\n- Added Separator component for visual separation of content.\n- Developed Table component with header, body, footer, and cell components for structured data display.\n- Introduced Tabs component for tabbed navigation with triggers and content areas.\n- Built Toast and Toaster components for displaying notifications with customizable actions.\n- Created TradingCard component for displaying financial data with trends and changes.\n- Added utility functions for formatting currency, numbers, and percentages.\n- Configured Tailwind CSS for styling and theming across the application.", "tree": {"sha": "4c6a9f20d69e3b6e0f24fc4439f02ac2600717ec", "url": "https://api.github.com/repos/DimaJoyti/go-coffee/git/trees/4c6a9f20d69e3b6e0f24fc4439f02ac2600717ec"}, "url": "https://api.github.com/repos/DimaJoyti/go-coffee/git/commits/a31eee021272140bec82d492c2fb94b9d2550e58", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/DimaJoyti/go-coffee/commits/a31eee021272140bec82d492c2fb94b9d2550e58", "html_url": "https://github.com/DimaJoyti/go-coffee/commit/a31eee021272140bec82d492c2fb94b9d2550e58", "comments_url": "https://api.github.com/repos/DimaJoyti/go-coffee/commits/a31eee021272140bec82d492c2fb94b9d2550e58/comments", "author": {"login": "DimaJ