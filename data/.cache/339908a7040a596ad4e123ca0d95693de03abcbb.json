[{"sha": "93f2e1572a761769025f47c9fada8c7d1ab07b2b", "node_id": "C_kwDOCkvtodoAKDkzZjJlMTU3MmE3NjE3NjkwMjVmNDdjOWZhZGE4YzdkMWFiMDdiMmI", "commit": {"author": {"name": "Jonathan King", "email": "jonathankingfc@gmail.com", "date": "2023-08-22T17:05:10Z"}, "committer": {"name": "OpenShift Merge Robot", "email": "openshift-merge-robot@users.noreply.github.com", "date": "2023-08-30T14:00:54Z"}, "message": "configmaps: Track resource versions of cluster provided CA certs (PROJQUAY-5174)\n\n- The config.openshift.io/inject-trusted-cabundle: 'true' annotation will inject content into the config map after kustomize has generated its resources. This means that kustomize will not be aware of changes made by Openshift to these config maps\n- In order to redeploy QuayRegistry resources when cluster CA are rotated, this PR implements a mechanism to track the resource version of the CA as an annotation on the Quay resources", "tree": {"sha": "0980ed20c255ca8f11b8d2c134d66e2294ec2fac", "url": "https://api.github.com/repos/quay/quay-operator/git/trees/0980ed20c255ca8f11b8d2c134d66e2294ec2fac"}, "url": "https://api.github.com/repos/quay/quay-operator/git/commits/93f2e1572a761769025f47c9fada8c7d1ab07b2b", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/quay/quay-operator/commits/93f2e1572a761769025f47c9fada8c7d1ab07b2b", "html_url": "https://github.com/quay/quay-operator/commit/93f2e1572a761769025f47c9fada8c7d1ab07b2b", "comments_url": "https://api.github.com/repos/quay/quay-operator/commits/93f2e1572a761769025f47c9fada8c7d1ab07b2b/comments", "author": {"login": "jonathankingfc", "id": 12652049, "node_id": "MDQ6VXNlcjEyNjUyMDQ5", "avatar_url": "https://avatars.githubusercontent.com/u/12652049?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jonathankingfc", "html_url": "https://github.com/jonathankingfc", "followers_url": "https://api.github.com/us