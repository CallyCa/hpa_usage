[{"sha": "6165aa764a62eda69f5eb1eb4e29121e45bcb9fc", "node_id": "C_kwDOPXpSJNoAKDYxNjVhYTc2NGE2MmVkYTY5ZjVlYjFlYjRlMjkxMjFlNDViY2I5ZmM", "commit": {"author": {"name": "Daniel Schmidt", "email": "danschmidt88@gmail.com", "date": "2025-08-28T00:09:23Z"}, "committer": {"name": "Daniel Schmidt", "email": "danschmidt88@gmail.com", "date": "2025-08-28T00:09:23Z"}, "message": "feat(deployment): add comprehensive Edge TPU v6 deployment guide and configs\n\n- Add deployment guide with architecture, steps, and operational procedures\n- Add disaster recovery backup and restore configuration with Velero\n- Add Argo Rollouts for blue-green and canary deployments\n- Add autoscaling configs (HPA, VPA, custom scaler)\n- Add namespaces and RBAC for production, staging, monitoring\n- Add monitoring stack with Prometheus, Grafana, Alertmanager\n- Add operational runbooks for common alerts and incidents\n- Add network policies and pod security standards\n- Add Istio service mesh setup with multi-region support\n- Add security scanning and runtime monitoring with Falco\n- Add alerting rules and dashboards for performance and security\n\nThis commit introduces a full enterprise-grade deployment framework for the Edge TPU v6 benchmark suite, enabling progressive quality gates, advanced monitoring, security hardening, and disaster recovery.\n\nCo-authored-by: terragon-labs[bot] <terragon-labs[bot]@users.noreply.github.com>", "tree": {"sha": "d03ad35d80742926b88f1a3fb251e19fa8a982ce", "url": "https://api.github.com/repos/danieleschmidt/Edge-TPU-v6-Preview-Bench/git/trees/d03ad35d80742926b88f1a3fb251e19fa8a982ce"}, "url": "https://api.github.com/repos/danieleschmidt/Edge-TPU-v6-Preview-Bench/git/commits/6165aa764a62eda69f5eb1eb4e29121e45bcb9fc", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/danieleschmidt/Edge-TPU-v6-Preview-Bench/commits/6165aa764a62eda69f5eb1eb4e2