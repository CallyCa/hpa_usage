[{"sha": "9d2a612188e37c7160fef8934b1a83df97a762b9", "node_id": "C_kwDOPkpfHtoAKDlkMmE2MTIxODhlMzdjNzE2MGZlZjg5MzRiMWE4M2RmOTdhNzYyYjk", "commit": {"author": {"name": "neelabhtripathi", "email": "itsneelabh@gmail.com", "date": "2025-09-25T02:59:27Z"}, "committer": {"name": "neelabhtripathi", "email": "itsneelabh@gmail.com", "date": "2025-09-25T02:59:27Z"}, "message": "feat: add error_handling and context_propagation examples\n\nAdd two new comprehensive examples demonstrating core GoMind patterns:\n\n\u2022 error_handling example showcases:\n  - Standard error types and sentinel errors\n  - Error classification utilities (IsRetryable, IsConfigurationError)\n  - Structured error handling with FrameworkError\n  - Real-world agent implementation patterns\n\n\u2022 context_propagation example demonstrates:\n  - Automatic context propagation with telemetry baggage\n  - Multi-layer observability across request lifecycle\n  - Production-ready telemetry integration patterns\n  - End-to-end metric correlation and debugging\n\nBoth examples include:\n- Comprehensive README documentation with usage examples\n- Proper module configuration with local development setup\n- Working code that builds and runs successfully\n- Educational content following framework best practices", "tree": {"sha": "f353422d85a577ceb5c12444d9ed53576000c9da", "url": "https://api.github.com/repos/itsneelabh/gomind/git/trees/f353422d85a577ceb5c12444d9ed53576000c9da"}, "url": "https://api.github.com/repos/itsneelabh/gomind/git/commits/9d2a612188e37c7160fef8934b1a83df97a762b9", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/itsneelabh/gomind/commits/9d2a612188e37c7160fef8934b1a83df97a762b9", "html_url": "https://github.com/itsneelabh/gomind/commit/9d2a612188e37c7160fef8934b1a83df97a762b9", "comments_url": "https://api.github.com/repos/itsneelabh/gomind/commits/9d2a612188e37c7160fef8