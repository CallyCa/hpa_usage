[{"sha": "fac3138b750e84b988a76e922fb9e9f6bfa26e65", "node_id": "C_kwDOKzIOE9oAKGZhYzMxMzhiNzUwZTg0Yjk4OGE3NmU5MjJmYjllOWY2YmZhMjZlNjU", "commit": {"author": {"name": "Kevin Carter", "email": "kevin@cloudnull.com", "date": "2024-11-21T21:16:08Z"}, "committer": {"name": "GitHub", "email": "noreply@github.com", "date": "2024-11-21T21:16:08Z"}, "message": "fix: resolve Kustomize deprecations (#584)\n\nKustomize has deprecated the use of a couple feature flags and we need to\r\nmake adjustments to ensure that we're maintaining the environment in\r\nexpected ways.\r\n\r\n* remove the CLI option from `kustomize.sh` to disable automatic reordering\r\n* add the `sortOptions` keyword to the base kustomization files to ensure\r\n  resource sorting is handled as fifo.\r\n* replace the `bases` keyword with the `resources` keyword\r\n\r\nSigned-off-by: Kevin Carter <kevin.carter@rackspace.com>", "tree": {"sha": "821f85dfd3824bcbcd58577e31b14352b1a2bf9d", "url": "https://api.github.com/repos/rackerlabs/genestack/git/trees/821f85dfd3824bcbcd58577e31b14352b1a2bf9d"}, "url": "https://api.github.com/repos/rackerlabs/genestack/git/commits/fac3138b750e84b988a76e922fb9e9f6bfa26e65", "comment_count": 0, "verification": {"verified": true, "reason": "valid", "signature": "-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJnP6MYCRC1aQ7uu5UhlAAAjBcQABnQ55MILvW8U6p/buSiDvko\n74NlX12CV1tTMHSu5lCw1xftBVwOMAXj7Pu4ir5prVMM45KQ1Zf7h0bjRX3GNqOW\nwuGNSY4/POxbNDwoszqiRtyAKhMSZ57tWHIVX2iBWJiWUSWrYj9iBlI43LgeHy2s\nJ54G5dFLFg5SC19xDpGjaH8pucITyX3WVQuOgds5Rzugc1wg2qUbg5urdQJgxw9O\nlOf0OQazYGi3lfo4AnPjCHLLDHCWQjhWBF/s61HivQotNmtoVyl79rE7ZJEVS70P\n378vwmrwXPl5omqCOmmXSeWCxonkzIL1ArvxmH/J4iQ/UFIupxBwhEV/lbjUeYgt\n/QNqNvH02kd1vkCQWEP58BwQSBDyyYR285rlB3QOHSK4akG9myxuxc51WSVxCIVk\n/ssPkuEjciSHJoN6+9145Nf+pdMy8u8hoduT2gb8kCIFoRKJNsSgrR1XBdb/LCH9\novwSdRYq438Iz8Mr+00lA4uQGJWWRjsw1toAIGyKiVbCoxFi554qBSS6B+OJsMYj\n+5nSwLXMP+t03vIeKuU3E+M14S66AAj4letpp7lAkYZ69vC5XEEPg9Zt0O5CPKIV\nYAg5CD+FnC4mlpirbtnaOKIWg8ieu2BVA6Fo/nLkws/28zUQHEBubFENrUGMk3Bi\n38Id7gU4o4Jes/KyWuiI\n=g8uJ\n-----END PGP SIGNATURE-----\n", "payload": "tree 821f85dfd3824bcbcd58577e31b14352b1a2bf9d\nparent 95cb4c1825a812de03705d385d9042d4bf021e5f\nauthor Kevin Carter <kevin@cloudnull.com> 1732223768 -0600\ncommitter GitHub <noreply@github.com> 1732223768 -0600\n\nfix: resolve Kustomize deprecations (#584)\n\nKustomize has deprecated the use of a couple feature flags and we need to\r\nmake adjustments to ensure that we're maintaining the environment in\r\nexpected ways.\r\n\r\n* remove the CLI option from `kustomize.sh` to disable automatic reordering\r\n* add the `sortOptions` keyword to the base kustomization files to ensure\r\n  resource sorting is handled as fifo.\r\n* replace the `bases` keyword with the `resources` keyword\r\n\r\nSigned-off-by: Kevin Carter <kevin.carter@rackspace.com>", "verified_at": "2024-11-21T21:18:25Z"}}, "url": "https://api.github.com/repos/rackerlabs/genestack/commits/fac3138b750e84b988a76e922fb9e9f6bfa26e65", "html_url": "https://github.com/rackerlabs/genestack/commit/fac3138b750e84b988a76e922fb9e9f6bfa26e65", "comments_url": "https://api.github.com/repos/rackerlabs/genestack/commits/fac3138b750e84b988a76e922fb9e9f6bfa26e65/comments", "author": {"login": "cloudnull", "id": 2066292, "node_id": "MDQ6VXNlcjIwNjYyOTI=", "avatar_url": "https://avatars.githubusercontent.com/u/2066292?v=4", "gravatar_id": "", "url": "https://api.github.com/users/cloudnull", "html_url": "https://github.com/cloudnull", "followers_url": "https://api.github.com/users/cloudnull/followers", "following_url": "https://api.github.com/users/cloudnull/following{/other_user}", "gists_url": "https://api.github.com/users/cloudnull/gists{/gist_id}", "starred_url": "https://api.github.com/users/cloudnull/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/cloudnull/subscriptions", "organizations_url": "https://api.github.com/users/cloudnull/orgs", "repos_url": "https://api.github.com/users/cloudnull/r