[{"sha": "10bbfb2461a5465c52f9e4cd2f5992b9296e00c3", "node_id": "C_kwDOPiZijdoAKDEwYmJmYjI0NjFhNTQ2NWM1MmY5ZTRjZDJmNTk5MmI5Mjk2ZTAwYzM", "commit": {"author": {"name": "Farid", "email": "andhika.10124357@mahasiswa.unikom.ac.id", "date": "2025-08-22T17:06:25Z"}, "committer": {"name": "Farid", "email": "andhika.10124357@mahasiswa.unikom.ac.id", "date": "2025-08-22T17:06:25Z"}, "message": "feat(secrets-rotation): Add comprehensive secrets and key rotation runbook\n\n- Documented secrets handling and encryption key management using envelope encryption.\n- Defined rotation policies for Data Encryption Keys (DEK) and Key Encryption Keys (KEK).\n- Included operational steps for production and rollback procedures.\n- Added evidence-producing dev rotation test with expected outputs.\n\nfeat(kubernetes): Introduce namespace and network policies for compliance\n\n- Created a new Kubernetes namespace for merajutasa with restricted pod security policies.\n- Implemented network policies to allow communication between compliance-related components and service mesh.\n\nfeat(kyverno): Add image verification policy for container security\n\n- Established a Kyverno policy to enforce signed images for Pods in the merajutasa namespace.\n\nfeat(observability): Implement security telemetry schema for standardized events\n\n- Developed a schema for standardizing security events across logs, metrics, and traces.\n- Included functions for creating and standardizing security events.\n\nfeat(tests): Enhance testing tools for API gateway and KMS mock\n\n- Created a tool to verify API gateway functionality and log results.\n- Developed a local KMS mock for envelope encryption demos and tests.\n\nfeat(infra): Add health check and validation scripts for Kubernetes deployments\n\n- Implemented scripts to validate Kubernetes baseline configurations and health status.\n- Generated reports for policy drift and system health.\n\nfeat(observability): Simulate observability metrics and alert rules\n\n- Created a simulation tool for observability metrics to trigger alert rules and write artifacts.\n\nfeat(secrets-rotation): Implement secrets rotation test script\n\n- Developed a script to simulate envelope encryption rotation and validate DEK operations.\n- Outputs deterministic artifacts without plaintext secrets.\n\nfeat(sla): Seed SLA monitor with healthy sample data\n\n- Implemented a script to seed the SLA monitor with healthy response time metrics and write status artifacts.", "tree": {"sha": "aa984a824f619ac790af4427d98b2411bf3a0382", "url": "https://api.github.com/repos/xcodeprem/merajutasa.id/git/trees/aa984a824f619ac790af4427d98b2411bf3a0382"}, "url": "https://api.github.com/repos/xcodeprem/merajutasa.id/git/commits/10bbfb2461a5465c52f9e4cd2f5992b9296e00c3", "comment_count": 0, "verification": {"verified": false, "reason": "unsigned", "signature": null, "payload": null, "verified_at": null}}, "url": "https://api.github.com/repos/xcodeprem/merajutasa.id/commits/10bbfb2461a5465c52f9e4cd2f5992b9296e00c3", "html_url": "https://github.com/xcodeprem/merajutasa.id/commit/10bbfb2461a5465c52f9e4cd2f5992b9296e00c3", "comments_url": "https://api.github.com/repos/xcodeprem/merajutasa.id/commits/10bbfb2461a5465c52f9e4cd2f5992b9296e00c3/comments", "author": {"login": "Andhika-Rey", "id": 212610633, "node_id": "U_kgDODKwuSQ", "avatar_url": "https://avatars.githubusercontent.com/u/212610633?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Andhika-Rey", "html_url": "https://github.com/Andhika-Rey", "followers_url": "https://api.github.com/users/Andhika-Rey/followers", "following_url": "https://api.github.com/users/Andhika-Rey/following{/other_user}", "gists_url": "https://api.github.com/users/Andhika-Rey/gists{/gist_id}", "starred_url": "https://api.github.com/users/Andhika-Rey/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Andhika-Rey/subscriptions", "organizations_url": "https://api.github.com/users/Andhika-Rey/orgs", "repos_url":